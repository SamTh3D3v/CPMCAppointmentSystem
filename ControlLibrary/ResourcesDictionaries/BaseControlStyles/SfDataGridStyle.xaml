<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf">
    <Style TargetType="Syncfusion:SfDataGrid">
        <Setter Property="AllowFiltering" Value="True"></Setter>
        <Setter Property="AllowDraggingColumns" Value="True"></Setter>
        <Setter Property="AllowGrouping" Value="True"></Setter>
        <Setter Property="FontFamily" Value="Segoe UI"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="Foreground" Value="Black"></Setter>
        <Setter Property="FontWeight" Value="Light"></Setter>
        <Setter Property="RowHeight" Value="32"></Setter>
        <Setter Property="HeaderRowHeight" Value="32"></Setter>
        <Setter Property="RowSelectionBrush" Value="#FFFFB661"></Setter>
        <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>
    
</ResourceDictionary>