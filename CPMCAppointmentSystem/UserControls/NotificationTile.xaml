<UserControl x:Class="CPMCAppointmentSystem.UserControls.NotificationTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:model="clr-namespace:DataLayer.Model;assembly=DataLayer"
             mc:Ignorable="d" 
              d:DesignWidth="310">
    <Grid Margin="2" Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush Color="WhiteSmoke" Opacity=".2"></SolidColorBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Critical}">
                            <Setter Property="Background" Value="Red"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Reminder}">
                            <Setter Property="Background" Value="Orange"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Warnning}">
                            <Setter Property="Background" Value="Yellow"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Information}">
                            <Setter Property="Background" Value="DodgerBlue"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Path Grid.Row="1" Grid.Column="0" Fill="White" Margin="5"  VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform">
            <Path.Style>
                <Style TargetType="Path">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Critical}">
                            <Setter Property="Data" Value="{StaticResource CriticalPath}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Reminder}">
                            <Setter Property="Data" Value="{StaticResource ReminderPath}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Warnning}">
                            <Setter Property="Data" Value="{StaticResource WarnningPath}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NotificationType}" Value="{x:Static model:TypeNotification.Information}">
                            <Setter Property="Data" Value="{StaticResource InfoPath}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>
        <TextBlock Style="{StaticResource SubheaderTextBlockStyle}" Text="{Binding NotificationTitle}" FontSize="20" Foreground="White" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Margin="2"/>
       <Grid Grid.Row="1" Grid.Column="2">
           <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>
            <Button  Name="BtnClose" Style="{DynamicResource MetroCircleButtonStyle}" Grid.Row="0"  Width="27" BorderBrush="White" Height="27" Margin="5 0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent" Click="RemoveNotificationClick">               
                <Path Fill="White" Data="{StaticResource ClosePath}" Stretch="Uniform" Width="10" Height="10">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=BtnClose,Path=IsMouseOver}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentColorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>
            <ToggleButton  Name="BtnExpand" Style="{DynamicResource MetroCircleToggleButtonStyle}" BorderBrush="White"  Grid.Row="1"   Width="30" Height="30" Margin="5 0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent">                               
               
               <Path Stretch="Uniform" Width="15" Height="15">
                    <Path.Style>                        
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="White"/>
                            <Setter Property="Data" Value="{StaticResource ExpandPath}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=BtnExpand,Path=IsMouseOver}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentColorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=BtnExpand,Path=IsChecked}" Value="True">                                   
                                    <Setter Property="Data" Value="{StaticResource ExpandBackPath}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </ToggleButton>
        </Grid>
        <ScrollViewer Name="SchViewMessage" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" Margin="5" Background="#77ffffff" Height="100">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=BtnExpand,Path=IsChecked}" Value="True">
                            <Setter Property="Visibility" Value="Visible"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}"  Text="{Binding NotificationMessage}" FontSize="15" Foreground="Black"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="5" TextWrapping="Wrap" />
        </ScrollViewer>      
    </Grid>
</UserControl>
