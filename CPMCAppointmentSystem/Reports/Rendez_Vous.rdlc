<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="Textbox9">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>RENDEZ - VOUS</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>Underline</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Monsieur, Madame  </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!NomPatient.Value</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!PrenomParient.Value</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Vous avez rendez vous de consulatation de Radiothérapie le </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!DateRdv.Value</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>    A votre arrivée dans le service: </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>Adressez vous a l'accueil</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>, et remettez ce document à l'hotesse.</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>    Attendez en salle d'attente </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>(Pour éviter l'encombrement, les accompagnateurs sont priés de rester dans les salles extérieures)</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>.</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>    Vous serez appelé au secrétariat pour l'ouverture du dossier médical. Vous devez présenter : le Livret de famille et un justificatif de votre adresse permanente (Reçu d'électricité). </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>Les informations recueilles doivent étre très précises, afin d'éviter les erreurs.</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>Underline</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>    Vous serez ensuite examiné par votre médecin en consultatio, muni de votre dossier médical :</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value> Dossier radiologique complet (les clichés vous seront restitués)</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value> Compte rendu histologique</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value> Compte rendu opératoire</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value> Tous autre examen</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value> CARTE D'IDENTITE</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <ListStyle>Bulleted</ListStyle>
            <ListLevel>1</ListLevel>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>    Au terme de cette consultation, votre médecin vous donnera des explication relatives à votre prise en charge en radiothérapie, </Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>posez lui toutes les questions que vous jugerez utiles</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>Underline</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>.</Value>
                <Style>
                  <FontFamily>Segoe UI Light</FontFamily>
                  <FontSize>14pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Textbox9</rd:DefaultName>
