                <RadioButton Grid.Column="2" GroupName="menu" Content="My Patients" Width="100" Command="{Binding MyPatientsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Grid.Column="3" GroupName="menu" Content="Doctors"  Width="100" Command="{Binding DoctorsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Grid.Column="4" GroupName="menu" Content="Specialities"  Width="100" Command="{Binding SpecialitiesCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Grid.Column="5" GroupName="menu" Content="Pathologies"  Width="100" Command="{Binding PathologiesCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Grid.Column="6" GroupName="menu" Content="Statistics" Width="100" Command="{Binding StatisticsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Grid.Column="7" GroupName="menu" Content="Notifications" Width="100" Command="{Binding NotificationsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Grid.Column="8" GroupName="menu" Content="Settings" Width="100" Command="{Binding SettingsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
