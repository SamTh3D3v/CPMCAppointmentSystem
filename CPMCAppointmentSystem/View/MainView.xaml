<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:Custom="http://metro.mahapps.com/winfx/xaml/controls"
      x:Class="CPMCAppointmentSystem.View.MainView"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
	Title="MainView" x:Name="RootWindow">
	<Page.Resources>
        <Storyboard x:Key="NotificationAnimationStart" RepeatBehavior="Forever">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
				<EasingColorKeyFrame KeyTime="0" Value="#FF818F94"/>
				<EasingColorKeyFrame KeyTime="0:0:0.5" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:1" Value="#FF818F94"/>
			</ColorAnimationUsingKeyFrames>
		</Storyboard>
        <Storyboard x:Key="NotificationAnimationStop">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="#FF818F94"/>
                <EasingColorKeyFrame KeyTime="0:0:0" Value="#FF818F94"/>
			</ColorAnimationUsingKeyFrames>
		</Storyboard>
	</Page.Resources>
	
   
    <Page.DataContext>
        <Binding Path="MainViewModel" Source="{StaticResource Locator}"/>
    </Page.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding MainViewLoadedCommand, Mode=OneWay}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=MainViewUnloadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>  

    <Grid Background="{StaticResource BodyBackgroundBrush}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource HeaderBackgroundBrush}"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>                
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource SideLogo}"/>
            <Grid  Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>                    
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    
                </Grid.ColumnDefinitions>
                <RadioButton Name="RbCalendar" Visibility="{Binding ConnectedUser.RolesCollection.AppointementViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="0" GroupName="menu" Content="Calendrier" Width="100" Command="{Binding CalendarCommand}" Style="{StaticResource HeaderToggleButtonStyle}" Height="45" VerticalAlignment="Top"/>
                <RadioButton Name="RbPatients" Visibility="{Binding ConnectedUser.RolesCollection.PatientsViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="1" GroupName="menu" Content="Patients"  Width="100" Command="{Binding PatientsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbMesPatient" Visibility="{Binding ConnectedUser.RolesCollection.MyPatientsViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="2" GroupName="menu" Content="Mes Patients" Width="100" Command="{Binding MyPatientsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbMedecin" Visibility="{Binding ConnectedUser.RolesCollection.DoctorsViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="3" GroupName="menu" Content="Medecins"  Width="100" Command="{Binding DoctorsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbSpeciality" Visibility="{Binding ConnectedUser.RolesCollection.SpecialitiesViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="4" GroupName="menu" Content="Spécialités"  Width="100" Command="{Binding SpecialitiesCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbPathology" Visibility="{Binding ConnectedUser.RolesCollection.PathologiesViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="5" GroupName="menu" Content="Pathologies"  Width="100" Command="{Binding PathologiesCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbStatistique" Visibility="{Binding ConnectedUser.RolesCollection.StatisticsViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="6" GroupName="menu" Content="Statistiques" Width="100" Command="{Binding StatisticsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbNotification" Visibility="{Binding ConnectedUser.RolesCollection.SmsNotificationViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="7" GroupName="menu" Content="Notifications" Width="100" Command="{Binding NotificationsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbLog" Visibility="{Binding ConnectedUser.RolesCollection.LogViewAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="8" GroupName="menu" Content="Log" Width="100" Command="{Binding LogCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton Name="RbParametre" Visibility="{Binding ConnectedUser.RolesCollection.SettingsViewUsersAllow,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="9" GroupName="menu" Content="Paramètres" Width="100" Command="{Binding SettingsCommand}" Style="{StaticResource HeaderToggleButtonStyle}"/>
                <RadioButton ToolTip="Notification" Grid.Column="11" GroupName="menu" Width="50" Command="{Binding ShowNotificationFlayoutCommand}" Style="{StaticResource HeaderToggleButtonStyle}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">						
                        <Path Fill="#818f94" Data="{StaticResource NotificationBellPath}" Stretch="Uniform"  Width="20" Height="20" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnseenNotification}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource NotificationAnimationStart}"/>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard Storyboard="{StaticResource NotificationAnimationStop}"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>                                        
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Fill="{DynamicResource HeaderForgound}" Data="{StaticResource NotificationArrowPath}" Stretch="Uniform"  Width="14" Height="14" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5"/>
                    </StackPanel>
                </RadioButton>  
                <RadioButton ToolTip="Current User" Grid.Column="12" GroupName="menu" Width="50" Command="{Binding ShowCurrentUserFlayoutCommand}" Style="{StaticResource HeaderToggleButtonStyle}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Path Fill="{DynamicResource HeaderForgound}" Data="M28.723825,40.102001L32.210999,43.591721 29.501307,46.301495 32.297999,49.541874 28.597441,60.632 24.785,49.669441 27.905798,46.261566 25.234,43.591721z M43.435048,39.726002C52.006677,41.336922,58.495,48.856407,58.495,57.894215L58.495,65.103996 0,65.103996 0,57.894215C0,48.934509,6.3749619,41.46172,14.83595,39.7664L28.484497,61.161255z M24.189103,8.5674068C22.366207,8.5628349 20.067921,9.0320875 19.798519,11.369954 19.798519,11.369954 19.798519,15.912555 18.586079,16.518814L18.285145,20.758328 17.072618,19.546841 17.526172,25.300928 19.798519,25.453722C19.798519,25.453722 20.40487,37.112187 31.45946,34.842007 31.45946,34.842007 36.758903,33.175846 37.96919,25.453722L39.788066,25.300928 40.241622,20.152067 39.484893,20.304688C39.484893,20.304688,39.029094,15.912555,38.57554,14.096015L38.272363,9.7048294C38.272363,9.7048294 35.698998,7.5840813 31.913102,9.4017421 31.913102,9.4017421 27.52086,9.2491199 26.46104,8.7954809 26.46104,8.7954809 25.436347,8.5705349 24.189103,8.5674068z M29.371486,5.1102859E-08C34.5339,-0.00043190847 38.121585,2.7377144 38.121585,2.7377144 44.784036,8.0381061 41.150804,17.124359 41.150804,17.124359 42.664245,18.032574 42.513867,18.789286 42.513867,18.789286 42.513867,28.633459 39.787824,27.875542 39.787824,27.875542 38.272136,34.235779 32.368737,37.112168 32.368737,37.112168 20.858386,39.989773 17.982048,28.027123 17.982048,28.027123 15.559089,27.724041 15.256004,22.12155 15.256004,22.12155 14.496953,18.335739 16.618984,16.821194 16.618983,16.821194 12.074167,6.2215973 20.252215,3.0420038 20.252215,3.042004 23.531173,0.75185433 26.667365,0.0002266273 29.371486,5.1102859E-08z" Stretch="Uniform"  Width="20" Height="20" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5"/>
                        <Path Fill="{DynamicResource HeaderForgound}" Data="F1M181.297,177.841L181.205,177.746 181.385,177.563 202.804,156.146 202.804,135.07 178.497,159.373 170.847,167.026 170.666,167.205 163.107,159.653 138.804,135.345 138.804,156.42 160.219,177.841 170.76,188.379 181.297,177.841z" Stretch="Uniform"  Width="14" Height="14" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5"/>
                    </StackPanel>
                </RadioButton>                               
            </Grid>
        </Grid>
        <Frame Grid.Row="1" x:Name="InnerFrame" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0" LoadCompleted="InnerFrame_OnSourceUpdated"/>
    </Grid>
</Page>
