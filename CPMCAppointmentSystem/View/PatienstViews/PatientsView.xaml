<Page x:Class="CPMCAppointmentSystem.View.PatienstViews.PatientsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800" DataContext="{Binding Source={StaticResource Locator},Path=PatientsViewModel}"
	Title="PatientsView">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=PatientsViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource NavigationPanelBackgroundBrush}">
            <!--the list of patients Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="20,0,0,0" Text="Patients" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="0" />
            <ToggleButton x:Name="FilterTb" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"  Width="25" Height="25" Padding="0" Margin="5,0,0,0">
                <Image Source="{StaticResource FilterDark}"></Image>
            </ToggleButton>
            <Button Grid.Row="0" Grid.Column="2"  Margin="10" Command="{Binding AddPatientCommand}" ToolTip="Show filter">
                <Button.Content>
                    <Image Source="{StaticResource AddNewDark}" Width="40" Height="40" ></Image>
                </Button.Content>
            </Button>
            <Rectangle Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=FilterTb,Path=IsChecked}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=FilterTb,Path=IsChecked}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <Syncfusion:SfMaskedEdit Grid.Row="0" Grid.Column="0" Text="{Binding FilterText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"                                      
                                     Watermark="Filtrer les patients"  
                                     />
                <ComboBox Grid.Row="0"  Grid.Column="1" Margin="2 5" x:Name="FiltrerParBox" ItemsSource="{Binding FilterByCollection}" SelectedItem="{Binding FilterBySelectedItem,Mode=TwoWay}"/>
                <TextBlock Grid.Row="0"  Grid.Column="1"  Text="Par" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=FiltrerParBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Row="0"  Grid.Column="2"  Margin="2 5" x:Name="PieceJTypeBox" ItemsSource="{Binding TypePieceJointeList}" DisplayMemberPath="PieceJointeTitle" SelectedItem="{Binding SelectedTypePieceJointeInFilter,Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=FiltrerParBox,Path=SelectedValue}" Value="Piece Jointe">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Grid.Row="0"  Grid.Column="2"  Text="Type" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=PieceJTypeBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=PieceJTypeBox}" Value="Collapsed">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid  Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Date de dépot" Grid.Column="0" VerticalAlignment="Center"/>
                    <Syncfusion:DateTimeEdit  Grid.Column="1" x:Name="DateDepotBoxTimeEdit"  Margin="10 5"  HorizontalAlignment="Stretch">
                        <Syncfusion:DateTimeEdit.Style>
                            <Style TargetType="Syncfusion:DateTimeEdit">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=DateDepotCb,Path=IsChecked}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=DateDepotCb,Path=IsChecked}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Syncfusion:DateTimeEdit.Style>
                    </Syncfusion:DateTimeEdit>
                    <CheckBox Grid.Column="2" x:Name="DateDepotCb"></CheckBox>
                </Grid>

            </Grid>
            <Syncfusion:SfDataGrid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="sfgrid"
                                       AllowDraggingColumns="True"
                                       AllowEditing="False"
                                       AllowFiltering="True"
                                       AllowGrouping="True"                                   
                                       ItemsSource="{Binding PatientList}"
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedPatient}"
                                       ShowGroupDropArea="True" >
                <Syncfusion:SfDataGrid.Columns>
                    <Syncfusion:GridTextColumn HeaderText="Nom" MappingName="Nom" />
                    <Syncfusion:GridTextColumn HeaderText="Prenom" MappingName="Prenom" />
                    <Syncfusion:GridTextColumn HeaderText="Sexe" MappingName="Sexe.Designation"/>
                    <Syncfusion:GridTextColumn HeaderText="Date de naiss" DisplayBinding="{Binding Path=DateDeNaissance,
                                                                            StringFormat=d}"/>
                    <Syncfusion:GridTextColumn HeaderText="Tel" MappingName="TelephoneFixe"/>
                    <Syncfusion:GridTextColumn HeaderText="Mobile 1" MappingName="TelephoneMobile1"/>
                    <Syncfusion:GridTextColumn HeaderText="Mobile 2" MappingName="TelephoneMobile2"/>
                    <Syncfusion:GridTextColumn HeaderText="Willaya" MappingName="Adresse.Willaya.Designation"/>
                    <Syncfusion:GridTextColumn HeaderText="Code Postale" MappingName="Adresse.CodePosatal"/>

                </Syncfusion:SfDataGrid.Columns>
            </Syncfusion:SfDataGrid>

        </Grid>
        <GridSplitter Grid.Column="1" Width="1" Background="LightGray" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2" Background="{StaticResource BodyBackgroundBrush}" DataContext="{Binding SelectedPatient,Mode=TwoWay}" IsEnabled="{Binding DataContext.IsFormEnabled,RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <!--the patients details Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,20" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Image x:Name="WebCamPic" Source="{StaticResource FaceDark}" Grid.Column="0" Grid.Row="0" Width="75"/>
                <Border x:Name="WebCamBorder"  Background="WhiteSmoke" Grid.Column="0" Grid.Row="0" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value=".01"></Setter>
                            <Style.Triggers>
                                <Trigger  Property="IsMouseOver"  Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Source="{StaticResource CameraDark}" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0" />
                        <Button Grid.Column="0" Grid.Row="1"  Margin="2" ToolTip="WebCam">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource WebcamDark}" Width="15" Height="15" />                                    
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Grid.Row="1"  Margin="2" ToolTip="Upload">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource UploadDark}" Width="15" Height="15" />                                    
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

                <controls:ToggleSwitch  Header="Carte professionel" OnLabel="Oui" OffLabel="Non" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"/>
                <!--To be updated with the proper control-->
                <!--<TextBlock Grid.Column="1"    VerticalAlignment="Center" Margin="5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding PatientId}"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=PatientId}" Value="Guid.Empty">
                                    <Setter Property="Text" Value="GeneratedID"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>-->

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Num D'ordre" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding NumeroDordre,Mode=TwoWay}" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Numero d'ordre"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding Nom,Mode=TwoWay}" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Nom"  
                                     />


                <TextBlock Grid.Column="0" Grid.Row="3" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding Prenom,Mode=TwoWay}" Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Prenom"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="4" Text="Date de naiss" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:DateTimeEdit  Margin="10 5"  Text="{Binding DateDeNaissance,Mode=TwoWay,StringFormat=d}"   x:Name="BirthDateBox" Grid.Column="1" Grid.Row="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="4"  Text="Date de naissance" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=BirthDateBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="0" Grid.Row="5" Text="Sexe" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:ComboBoxAdv Margin="10 5" ItemsSource="{Binding DataContext.SexeList,RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding Path=Sexe}" DisplayMemberPath="Designation"  x:Name="SexeBox" Grid.Column="1" Grid.Row="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="5"  Text="Sexe" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=SexeBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="0" Grid.Row="6" Text="TelephoneFixe" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding TelephoneFixe,Mode=TwoWay}" Grid.Row="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Telephone fixe"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="7" Text="Mobile 1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding TelephoneMobile1,Mode=TwoWay}" Grid.Row="7" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Telephone mobile 1"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="8" Text="Mobile 2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding TelephoneMobile2,Mode=TwoWay}" Grid.Row="8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Telephone mobile 2"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="9" Text="Adress" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding Adresse.AddressDesignation,Mode=TwoWay}" Grid.Row="9" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Adresse"  
                                     />

                <Grid Grid.Column="1" Grid.Row="10" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Syncfusion:SfMaskedEdit  Grid.Column="0" Text="{Binding Adresse.City,Mode=TwoWay}"  Margin="2 5"                                      
                                     Watermark="City"  
                                     />
                    <ComboBox x:Name="WillayaBox" Margin="2 5" ItemsSource="{Binding DataContext.WillayasList,RelativeSource={RelativeSource AncestorType={x:Type Page}}}" IsEditable="True" DisplayMemberPath="Designation" SelectedItem="{Binding Adresse.Willaya,Mode=TwoWay}" Grid.Column="1"/>
                    <TextBlock Grid.Column="1"   Text="Willaya">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=WillayaBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Syncfusion:SfMaskedEdit  Grid.Column="2" Text="{Binding Adresse.CodePosatal,Mode=TwoWay}"  Margin="2 5"                                      
                                     Watermark="code postal"  
                                     />
                </Grid>
                <TextBlock Grid.Column="0" Grid.Row="11" Text="Date depot" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:DateTimeEdit Margin="10 5"  Text="{Binding DateDeDepot,Mode=TwoWay,StringFormat=d}"   x:Name="DepotDateBox" Grid.Column="1" Grid.Row="11" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="11"  Text="Date de dépot" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DepotDateBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <GroupBox Header="select pathology" Grid.Column="0" Grid.Row="12" Grid.ColumnSpan="2">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock  Text="Pathology" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <Syncfusion:ComboBoxAdv Margin="10 5" ItemsSource="{Binding DataContext.PathologiesList,RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding Path=Pathology}" DisplayMemberPath="NomPathology"
                                                x:Name="PathologyBox" Grid.Column="1"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="1"   Text="Pathology" >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=PathologyBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>                    
                </GroupBox>
                

                <Grid Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"  Margin="2" Command="{Binding DataContext.SavePatientCommand,RelativeSource={RelativeSource AncestorType=Page}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                <TextBlock Text="Save" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="1"  Margin="2" Command="{Binding DataContext.DeletePatientCommand,RelativeSource={RelativeSource AncestorType=Page}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                <TextBlock Text="Delete" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="2"  Margin="2" Command="{Binding DataContext.CancelPatientChangesCommand,RelativeSource={RelativeSource AncestorType=Page}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Grid>
            <GridSplitter Background="Gray" Width="1" Margin="1,20,1,20" Grid.Column="1" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Syncfusion:TabControlExt  EnableLabelEdit="False" Syncfusion:SkinStorage.VisualStyle="Metro" Margin="5,30,5,5"
                                  CloseButtonType="Hide" ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False" TabStripPlacement="Left">

                    <Syncfusion:TabItemExt  MinHeight="35" x:Name="AppointementTab">
                        <Syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Appointements"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </Syncfusion:TabItemExt.HeaderTemplate>
                        <Syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding DataContext.AddAppointementCommand,RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Appointements" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <Syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                                       AutoGenerateColumns="False"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding DataContext.SelectedPatient.RendezVouses,RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                   SelectedItem="{Binding DataContext.SelectedAppointement,Mode=TwoWay,RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                       ShowGroupDropArea="True" >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <command:EventToCommand Command="{Binding Mode=OneWay, Path=DataContext.AppointementDoubleClickCommand,RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                            PassEventArgsToCommand="True" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Syncfusion:SfDataGrid.Columns>
                                        <Syncfusion:GridTextColumn HeaderText="Date" MappingName="DateTimeRdv" />
                                        <Syncfusion:GridTextColumn HeaderText="Lieu" MappingName="LieuRdv" />
                                        <Syncfusion:GridTextColumn HeaderText="Medecin" MappingName="Medecin.Nom"/>
                                    </Syncfusion:SfDataGrid.Columns>
                                </Syncfusion:SfDataGrid>

                            </Grid>
                        </Syncfusion:TabItemExt.Content>
                    </Syncfusion:TabItemExt>
                    <Syncfusion:TabItemExt  MinHeight="35" x:Name="DossierTab">
                        <Syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Dossier"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </Syncfusion:TabItemExt.HeaderTemplate>
                        <Syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding DataContext.AddAppointementCommand,RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Piece Jointe" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  Header="Nouveau">
                                    <Grid  >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ComboBox x:Name="TypeCbx" Grid.Row="0" ItemsSource="{Binding DataContext.TypePieceJointeList,ElementName=RootGrid,Mode=TwoWay}" SelectedItem="{Binding Path=DataContext.SelectedPieceJointe.TypePieceJointe,ElementName=RootGrid}" DisplayMemberPath="PieceJointeTitle" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"/>
                                        <TextBlock Grid.Row="0"  Text="Type Piece Jointe" >
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=TypeCbx}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Syncfusion:SfMaskedEdit Text="{Binding ElementName=RootGrid,Path=DataContext.SelectedPieceJointe.IdPieceJointe,Mode=TwoWay}" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"                                      
                                     Watermark="Id Piece Jointe"/>
                                        <Syncfusion:SfMaskedEdit Text="{Binding ElementName=RootGrid,Path=DataContext.SelectedPieceJointe.Description,Mode=TwoWay}" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"                                      
                                     Watermark="Description"/>
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Upload" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"/>
                                            <Button Content="Preview" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"/>
                                            <Button Content="Save" Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"/>
                                        </Grid>

                                    </Grid>
                                </GroupBox>
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
                                <GroupBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"  Header="Liste de pieces">
                                    <ListView ItemsSource="{Binding PieceJointes}"  SelectedItem="{Binding ElementName=RootGrid,Path=DataContext.SelectedPieceJointe}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox />
                                                    <TextBlock Grid.Column="1" Text=""/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </GroupBox>
                            </Grid>
                        </Syncfusion:TabItemExt.Content>
                    </Syncfusion:TabItemExt>
                    <Syncfusion:TabItemExt  MinHeight="35" x:Name="NotesTab">
                        <Syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Notes"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </Syncfusion:TabItemExt.HeaderTemplate>
                        <Syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Note" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Nouveau">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Syncfusion:SfMaskedEdit Text="{Binding NumeroDordre,Mode=TwoWay}" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Titre du remarque" />
                                        <Syncfusion:SfMaskedEdit Text="{Binding NumeroDordre,Mode=TwoWay}"  Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Contenu du remarque" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"  Margin="10 5">
                                                <Button.Content>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                                        <TextBlock Text="delete" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button.Content>
                                            </Button>
                                            <Button Grid.Column="1"  Margin="10 5">
                                                <Button.Content>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                                        <TextBlock Text="save" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button.Content>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
                                <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"  Header="List des notes">
                                    <ListView ItemsSource="{Binding Notes}" SelectedItem="{Binding ElementName=RootGrid,Path=DataContext.SelectedNote}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="Black" BorderThickness="1" Margin="5">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}"/>
                                                    </Grid>
                                                </Border>

                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </GroupBox>

                            </Grid>

                        </Syncfusion:TabItemExt.Content>
                    </Syncfusion:TabItemExt>


                    <!--<Syncfusion:TabControlExt.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ItemTemplate>
                    <Syncfusion:TabControlExt.ContentTemplate>
                        <DataTemplate>
                            <local:Weather BorderBrush="{Binding ElementName=options, Path=BorderBrush}" x:Name="weather"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ContentTemplate>-->
                </Syncfusion:TabControlExt>
            </Grid>


        </Grid>
    </Grid>
</Page>
