<controls:MetroWindow x:Class="CPMCAppointmentSystem.View.PatienstViews.PreviewPieceJointeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        WindowStyle="SingleBorderWindow"
        EnableDWMDropShadow="True"
        ResizeMode="CanResizeWithGrip"
        WindowTransitionsEnabled="False"                      
        BorderBrush="{DynamicResource AccentColorBr}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"                             
        Height="500" Width="700" DataContext="{Binding Source={StaticResource Locator},Path=PatientsViewModel}">
    <Grid Background="LightGray">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Image Source="{Binding PieceJointeImage}" Stretch="UniformToFill"/>
        </ScrollViewer>        
    </Grid>
</controls:MetroWindow>
