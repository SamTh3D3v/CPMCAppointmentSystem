<controls:MetroWindow x:Class="CPMCAppointmentSystem.View.PatienstViews.PreviewReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        WindowStyle="SingleBorderWindow"
        EnableDWMDropShadow="True"
        ResizeMode="CanResizeWithGrip"
        WindowTransitionsEnabled="False"                      
        BorderBrush="{DynamicResource AccentColorBr}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"                             
        Height="500" Width="700" DataContext="{Binding Source={StaticResource Locator},Path=PatientsViewModel}">
    <Grid>
        <syncfusion:ReportViewer Name="ReportPreviewer" ShowParametersBlock="False"  ReportPath="{Binding ReportPath,Mode=TwoWay}"  />
    </Grid>
</controls:MetroWindow>
