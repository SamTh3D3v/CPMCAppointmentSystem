<Page x:Class="CPMCAppointmentSystem.View.SettingsViews.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:behavior="clr-namespace:CPMCAppointmentSystem.Behavior"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="700" DataContext="{Binding Source={StaticResource Locator},Path=SettingsViewModel}"
	Title="SettingsView" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=SettingsViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Page.Resources>
        <Style TargetType="syncfusion:TreeViewItemAdv" x:Key="TreeViewItemConStyle">
            <Setter Property="IsExpanded" Value="True"/>
            <!--<Setter Property="LeftImageSource" Value="{StaticResource PathologyDark}"/>-->
        </Style>
        <HierarchicalDataTemplate x:Key="TvItemTemplate" ItemsSource="{Binding TreeViewModelCollection}">
            <CheckBox Content="{Binding Content}" IsChecked="{Binding Path=IsChecked,Mode=TwoWay}"/>
        </HierarchicalDataTemplate>
    </Page.Resources>

    <Grid  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TabControl  TabStripPlacement="Left"  Padding="0" Margin="0">
            <TabItem Style="{StaticResource SettingsTabItemStyle}">
                <TabItem.Header>
                    <Grid Width="120" Height="100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Source="{StaticResource AccountsDark}"></Image>
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}"  Foreground="#FF7B7B7B" Text="COMPTES" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListView Background="Transparent" ItemsSource="{Binding UserTypeCollection}" Grid.Column="0"  Margin="5" BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Focusable" Value="False"></Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ToggleButton IsChecked="{Binding IsAdded,Mode=TwoWay}" x:Name="FilterButton" Width="45" Height="45"  Background="WhiteSmoke" Style="{DynamicResource MetroCircleToggleButtonStyle}" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center">
                                                <Path Stretch="Uniform"  Width="20" Height="20" Margin="0,0,0,0" >
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="LightGray"></Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=FilterButton,Path=IsChecked}" Value="True">
                                                                    <Setter Property="Fill" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UserTypeName}" Value="Medecin">
                                                                    <Setter Property="Data" Value="{StaticResource DoctorPath}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UserTypeName}" Value="Admin">
                                                                    <Setter Property="Data" Value="{StaticResource AdminPath}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UserTypeName}" Value="Agent">
                                                                    <Setter Property="Data" Value="{StaticResource AgentPath}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </ToggleButton>
                                            <TextBlock Grid.Row="1" Style="{StaticResource SubheaderTextBlockStyle}"  FontSize="12" Margin="10"  Text="{Binding UserTypeName}"></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Grid.Row="0" Grid.Column="1"  Margin="10" Command="{Binding AddNewUserCommand}" ToolTip="Ajouter un nouveau utilisateur" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button.Content>
                                    <Image Source="{StaticResource AddNewDark}" Width="40" Height="40" ></Image>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <Grid Grid.Column="0" Grid.Row="1" Margin="4">
                            <syncfusion:SfDataGrid ColumnSizer="Star"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       AllowDraggingColumns="True"                                                   
                                       AllowEditing="False"
                                       AllowFiltering="True"
                                       AllowGrouping="True" 
                                                   AllowDeleting="True"
                                       ItemsSource="{Binding UsersList,Mode=TwoWay}"                                                   
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedUser,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn HeaderText="Nom" MappingName="UserNom" />
                                    <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="UserPrenom"/>
                                    <syncfusion:GridTextColumn HeaderText="UserName" MappingName="UserName"/>
                                    <syncfusion:GridTextColumn HeaderText="Type" MappingName="UserType.UserTypeName"/>
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </Grid>
                        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Background="Gray" Width="1" Margin="1" Grid.Column="1" VerticalAlignment="Stretch"/>
                        <Grid Grid.Row="0" Grid.Column="2" IsEnabled="{Binding IsFormEnabled}" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Grid.Column="0"  Header="Information globale">

                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding SelectedUser.UserNom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="0"                                       
                                     Watermark="Nom de l'utilisateur"  
                                     />

                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <syncfusion:SfMaskedEdit Grid.Column="1" Text="{Binding SelectedUser.UserPrenom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="1"                                      
                                     Watermark="Prenom de l'utilisateur" 
                                     />

                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="UserName" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <syncfusion:SfMaskedEdit Grid.Column="1" Text="{Binding SelectedUser.UserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="2"                                   
                                     Watermark="Prenom de l'utilisateur" 
                                     />


                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="Type" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <ComboBox x:Name="CbxUserType" Margin="10 5" ItemsSource="{Binding UserTypeCollection}" DisplayMemberPath="UserTypeName" SelectedItem="{Binding SelectedUser.UserType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Column="1" Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="1" Margin="10 5" Grid.Row="3"  Text="Type d'utilisateur" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CbxUserType}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Row="1" Grid.Column="0">
                                <GroupBox.Header>
                                    <CheckBox Content="Changer le password" x:Name="PassCheckBox" IsChecked="False"></CheckBox>
                                </GroupBox.Header>
                                <Grid IsEnabled="{Binding ElementName=PassCheckBox,Path=IsChecked}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <PasswordBox Margin="10 5"  x:Name="UserPass" Style="{DynamicResource  WaterMarkPasswordBoxStyle}" Grid.Column="1" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <PasswordBox.Resources>
                                            <system:String x:Key="WaterMarkText">Enter password</system:String>
                                        </PasswordBox.Resources>
                                    </PasswordBox>

                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Confirmer Password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <PasswordBox Margin="10 5" x:Name="UserConfirmPass" Style="{StaticResource WaterMarkPasswordBoxStyle}" Grid.Column="1" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <PasswordBox.Resources>
                                            <system:String x:Key="WaterMarkText">Confirme password</system:String>
                                        </PasswordBox.Resources>
                                    </PasswordBox>
                                </Grid>
                            </GroupBox>

                            <Expander IsExpanded="True" Grid.Row="2" Grid.Column="0"  Header="Rolls">
                                <syncfusion:TreeViewAdv ItemsSource="{Binding TreeViewRollCollection}" ItemTemplate="{StaticResource TvItemTemplate}" Background="Transparent" BorderThickness="0"  HorizontalAlignment="Stretch"
                                            AnimationType="Fade"
                                            ItemContainerStyle="{StaticResource TreeViewItemConStyle}" 
                                            ShowRootLines="True" 
                                            AllowMultiSelect="False" 
                                            AllowDragDrop="False">
                                </syncfusion:TreeViewAdv>
                            </Expander>
                            <Grid Grid.Row="4" Grid.Column="0"  VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"  Margin="2" Command="{Binding SaveSpecialityCommand}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                            <TextBlock Text="Save" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <Button Grid.Column="1"  Margin="2" Command="{Binding DeleteSpecialityCommand}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                            <TextBlock Text="Delete" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <Button Grid.Column="2"  Margin="2" Command="{Binding CancelSpecialityChangesCommand}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                            <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem Style="{StaticResource SettingsTabItemStyle}">
                <TabItem.Header>
                    <Grid Width="120" Height="100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Source="{StaticResource SettingsDark}"></Image>
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}"  Foreground="#FF7B7B7B" Text="PARAMETRE" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <TabItem.Content>
                    <TabControl TabStripPlacement="Left">
                        <TabItem  Style="{StaticResource InnerSettingsTabItemStyle}">
                            <TabItem.Header>
                                <Grid  Height="50" Margin="0,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource SettingsItem}"  Stretch="Uniform" Fill="#FF7B7B7B" Width="20" Height="20" Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5"/>
                                    <TextBlock Grid.Column="1" Text="Status des patient" Style="{StaticResource SubheaderTextBlockStyle}" FontSize="12" Margin="0,0,5,0"></TextBlock>
                                </Grid>
                            </TabItem.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <GroupBox Header="Carte proffesionel" Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Tiles brush" VerticalAlignment="Center"/>
                                        <xctk:ColorPicker Grid.Row="0" Grid.Column="1" Margin="30,5,5,5"  
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"                                                                                                                                                                                  
                                            />
                                        <controls:ToggleSwitch Grid.Row="0" Grid.Column="2" Width="150"  OnLabel="Blink" OffLabel="don't blink" />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Enfant" Grid.Row="0" Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Tiles brush" VerticalAlignment="Center"/>
                                        <xctk:ColorPicker Grid.Row="0" Grid.Column="1" Margin="30,5,5,5"  
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"                                                                                                                                                                                  
                                            />
                                        <controls:ToggleSwitch Grid.Row="0" Grid.Column="2" Width="150"  OnLabel="Blink" OffLabel="don't blink" Grid.ColumnSpan="2" Margin="0,2,38,31" Grid.RowSpan="2" />
                                        <TextBlock Text="Age minimum" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
                                        <syncfusion:SfMaskedEdit Margin="30,5,5,5"  Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"></syncfusion:SfMaskedEdit>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </TabItem>
                        <TabItem  Style="{StaticResource InnerSettingsTabItemStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <command:EventToCommand 
                            PassEventArgsToCommand="True" Command="{Binding TypePieceJointeDataGridLoadedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <TabItem.Header>
                                <Grid  Height="50" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource SettingsItem}"  Stretch="Uniform" Fill="#FF7B7B7B" Width="20" Height="20" Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5"/>
                                    <TextBlock Grid.Column="1" Text="Types des pieces joints" Style="{StaticResource SubheaderTextBlockStyle}" FontSize="12" Margin="0,0,5,0"></TextBlock>
                                </Grid>
                            </TabItem.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <GroupBox Header="Ajouter Une Type De Piece Jointe" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <syncfusion:SfDataGrid ColumnSizer="Star"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AddNewRowPosition="Top" AllowDeleting="True" 
                                                       AutoGenerateColumns="False"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding TypePieceJointeCollection}"
                                   SelectedItem="{Binding SelectedTypePieceJointe,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <command:EventToCommand 
                            PassEventArgsToCommand="True" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <syncfusion:SfDataGrid.Columns>
                                            <syncfusion:GridTextColumn HeaderText="Titre" Width="300" MappingName="PieceJointeTitle" />
                                            <syncfusion:GridTextColumn HeaderText="Description" Width="300" MappingName="Description"/>
                                        </syncfusion:SfDataGrid.Columns>
                                    </syncfusion:SfDataGrid>
                                </GroupBox>
                                <Grid Grid.Row="1" Grid.Column="0"  VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" HorizontalAlignment="Right" Width="200"  Margin="2" Command="{Binding SaveAddTypePieceJointsCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                                <TextBlock Text="Save" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Left" Width="200"  Margin="2" Command="{Binding CancelAddTypePieceJointsCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                                <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem  Style="{StaticResource InnerSettingsTabItemStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <command:EventToCommand 
                            PassEventArgsToCommand="True" Command="{Binding JourFerieDataGridLoadedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <TabItem.Header>
                                <Grid  Height="50" Margin="0,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource SettingsItem}"  Stretch="Uniform" Fill="#FF7B7B7B" Width="20" Height="20" Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5"/>
                                    <TextBlock Grid.Column="1" Text="les jours feries" Style="{StaticResource SubheaderTextBlockStyle}" FontSize="12" Margin="0,0,5,0"></TextBlock>
                                </Grid>
                            </TabItem.Header>
                            <TabItem.Content>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox Grid.Row="0" Header="Jour férié occasionnelle" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <syncfusion:SfDataGrid ColumnSizer="Star"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AddNewRowPosition="Top" AllowDeleting="True" 
                                                       AutoGenerateColumns="False"
                                                               EditTrigger="OnTap"
                                              LiveDataUpdateMode="AllowDataShaping"
                                               ShowRowHeader="True"
                                            AllowDraggingColumns="True"
                                             AllowEditing="True"
                                            AllowFiltering="True"
                                            AllowGrouping="True"
                                            ItemsSource="{Binding ListDesJourFeriesOccasionnelle,Mode=TwoWay}"
                                            SelectedItem="{Binding SelectedJourFerie,Mode=TwoWay}"
                                            ShowGroupDropArea="True" >
                                                <i:Interaction.Behaviors>
                                                    <behavior:InitialSetupBehaviour />
                                                </i:Interaction.Behaviors>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="MouseDoubleClick">
                                                        <command:EventToCommand 
                            PassEventArgsToCommand="True"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                                <syncfusion:SfDataGrid.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.MergedDictionaries>
                                                            <ResourceDictionary Source="/Syncfusion.SfGrid.WPF;component/Styles/Styles.xaml" />
                                                        </ResourceDictionary.MergedDictionaries>
                                                        <Style TargetType="syncfusion:AddNewRowControl">
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="Foreground" Value="#FF808080" />
                                                            <Setter Property="BorderBrush" Value="#FF7fd0de" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="syncfusion:AddNewRowControl">
                                                                        <Grid>
                                                                            <VisualStateManager.VisualStateGroups>
                                                                                <VisualStateGroup x:Name="AddNewRowStates">
                                                                                    <VisualState x:Name="Normal" />
                                                                                    <VisualState x:Name="Edit">
                                                                                        <Storyboard>
                                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_AddNewRowTextBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                                                    <DiscreteObjectKeyFrame.Value>
                                                                                                        <Visibility>Collapsed</Visibility>
                                                                                                    </DiscreteObjectKeyFrame.Value>
                                                                                                </DiscreteObjectKeyFrame>
                                                                                            </ObjectAnimationUsingKeyFrames>
                                                                                        </Storyboard>
                                                                                    </VisualState>
                                                                                    <VisualState x:Name="HasError">
                                                                                        <Storyboard>
                                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_InValidBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                                                                            </ObjectAnimationUsingKeyFrames>
                                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_AddNewRowTextBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                                                    <DiscreteObjectKeyFrame.Value>
                                                                                                        <Visibility>Collapsed</Visibility>
                                                                                                    </DiscreteObjectKeyFrame.Value>
                                                                                                </DiscreteObjectKeyFrame>
                                                                                            </ObjectAnimationUsingKeyFrames>
                                                                                        </Storyboard>
                                                                                    </VisualState>
                                                                                    <VisualState x:Name="NoError">
                                                                                        <Storyboard>
                                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_AddNewRowTextBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                                                    <DiscreteObjectKeyFrame.Value>
                                                                                                        <Visibility>Collapsed</Visibility>
                                                                                                    </DiscreteObjectKeyFrame.Value>
                                                                                                </DiscreteObjectKeyFrame>
                                                                                            </ObjectAnimationUsingKeyFrames>
                                                                                        </Storyboard>
                                                                                    </VisualState>
                                                                                </VisualStateGroup>
                                                                                <VisualStateGroup x:Name="BorderStates">
                                                                                    <VisualState x:Name="NormalRow" />
                                                                                    <VisualState x:Name="FooterRow">
                                                                                        <Storyboard BeginTime="0">
                                                                                            <ThicknessAnimationUsingKeyFrames BeginTime="0"
                                                                          Duration="1"
                                                                          Storyboard.TargetName="PART_AddNewRowBorder"
                                                                          Storyboard.TargetProperty="BorderThickness">
