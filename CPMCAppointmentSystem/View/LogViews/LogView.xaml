<Page x:Class="CPMCAppointmentSystem.View.LogViews.LogView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="800" DataContext="{Binding Source={StaticResource Locator}, Path=LogViewModel}"
	Title="LogView">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=LogViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=LogViewUnloadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Button VerticalAlignment="Top" HorizontalAlignment="Right" Style="{DynamicResource MetroCircleButtonStyle}">

        </Button>
        <syncfusion:LayoutControl HeaderDescriptionText="log des utilisateurs" 
                        HeaderText="LOG "
                        LayoutMode="Metro"
                        UserOptionsVisibility="Collapsed">
            <syncfusion:LayoutControl.GridView>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                        <syncfusion:SfDataGrid AllowEditing="False" x:Name="LogDataGrid" Background="WhiteSmoke"
                                       AllowFiltering="True"
                                       AutoGenerateColumns="False" 
                                           AllowGrouping="True"
                                           AllowDraggingColumns="True"
                                           AllowSorting="True"
                                       ColumnSizer="AutoWithLastColumnFill"
                                        SelectedItem="{Binding SelectedLog,Mode=TwoWay}"
                                       IsGroupDropAreaExpanded="True"
                                       ItemsSource="{Binding Path=PagedSource,
                                                             ElementName=LogDataPager}"
                                       RowHeight="40"
                                       NavigationMode="Row"
                                       ShowGroupDropArea="True" >
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn HeaderText="Date" DisplayBinding="{Binding Path=Date,
                                                                            StringFormat='{}{0:dd/MM/yyyy hh:mm:ss}'}" />

                                <syncfusion:GridTextColumn HeaderText="Utilisateur" MappingName="User.UserName" />
                                <syncfusion:GridTextColumn HeaderText="Machine" MappingName="Machine"  />
                                <syncfusion:GridTextColumn HeaderText="Nom Action" MappingName="ActionName" />
                                <syncfusion:GridTextColumn HeaderText="Entité" MappingName="EntitySet" />
                                <syncfusion:GridTextColumn HeaderText="Détails" MappingName="Message" />
                                <syncfusion:GridTextColumn HeaderText="Entité Parent" MappingName="ParentEntitySet" />
                                
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </ScrollViewer>                   
                    <syncfusion:SfDataPager x:Name="LogDataPager"
                                       Grid.Row="1"                                       
                                       Height="60"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       AccentBackground="#FF53C3D5"
                                       AccentForeground="White"
                                       NumericButtonCount="10"
                                       Orientation="Horizontal"
                                       PageSize="16"
                                       Source="{Binding LogCollectionList}" />
                </Grid>
            </syncfusion:LayoutControl.GridView>

        </syncfusion:LayoutControl>
    </Grid>
</Page>
