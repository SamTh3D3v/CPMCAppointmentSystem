<controls:MetroWindow x:Class="CPMCAppointmentSystem.View.AppointementViews.ListMedecinToAddView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="ListMedecinToAddView"  WindowStyle="SingleBorderWindow"
        EnableDWMDropShadow="True"
        ResizeMode="CanResizeWithGrip"
        WindowTransitionsEnabled="False"                      
        BorderBrush="{DynamicResource AccentColorBr}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"
        syncfusion:SkinStorage.VisualStyle="Metro"
                      DataContext="{Binding Source={StaticResource Locator},Path=CalendarViewModel}"
                             
         Height="500" Width="700" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="1" Header="Selectionner la liste des medecins a filtrer selon">
            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <syncfusion:SfDataGrid Grid.Row="0" Height="250" SelectionMode="Single"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="False"
                                       AllowFiltering="True"
                                       AllowGrouping="True"                                   
                                       ItemsSource="{Binding ElementName=DoctorDataPager,Path=PagedSource}"
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedAddDoctorToFilter}"
                                       ShowGroupDropArea="True" >

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn HeaderText="Nom" MappingName="Nom" />
                        <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="Prenom" />
                        <syncfusion:GridTextColumn HeaderText="Mobile" MappingName="TelephoneMobile" />
                        <syncfusion:GridCheckBoxColumn HeaderText="Ajouter" MappingName="IsAdded"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
                <syncfusion:SfDataPager x:Name="DoctorDataPager"
                                       Grid.Row="1"                                       
                                       Height="60"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       AccentBackground="#FF53C3D5"
                                       AccentForeground="White"
                                       NumericButtonCount="10"
                                       Orientation="Horizontal"
                                       PageSize="16"
                                       Source="{Binding AddDoctorsToFilterList}" />
            </Grid>
        </GroupBox>
        <Grid Grid.Row="2" Grid.Column="0"  VerticalAlignment="Bottom" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>                
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"  Margin="2" Command="{Binding SaveAppointementCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource FilterDark}" Width="20" Height="20" />
                        <TextBlock Text="Filtrer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Column="1"  Margin="2" Command="{Binding SaveAppointementCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                        <TextBlock Text="Annuler" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

    </Grid>
</controls:MetroWindow>
