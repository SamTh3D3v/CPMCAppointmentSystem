                                </syncfusion:SfRadialMenuItem.Header>
                            </syncfusion:SfRadialMenuItem>
                            <syncfusion:SfRadialMenuItem/>
                            <syncfusion:SfRadialMenuItem  Click="deleteButton_Click"  CheckMode="None" Command="{Binding DeleteAppointementFromRadialMenuCommand}" CommandParameter="{Binding ElementName=Schedule}" >
                                <syncfusion:SfRadialMenuItem.Header>
