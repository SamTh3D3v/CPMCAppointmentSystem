<Page x:Class="CPMCAppointmentSystem.View.AppointementViews.CalendarView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:helpers="clr-namespace:CPMCAppointmentSystem.Helpers"
      xmlns:appointementViews="clr-namespace:CPMCAppointmentSystem.View.AppointementViews"
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:model="clr-namespace:DataLayer.Model;assembly=DataLayer"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
	Title="CalendarView" DataContext="{Binding Source={StaticResource Locator},Path=CalendarViewModel}">
    <Page.Resources>
        <Storyboard x:Key="SchedulerTypeSelectorDisapear">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" >
                <EasingDoubleKeyFrame KeyTime="0" Value="400"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="ScheduleTypeSelectorAppears">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" >
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="400">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="ArrowGoDownAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="-90"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="ArrowGoUpAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                <EasingDoubleKeyFrame KeyTime="0" Value="-90"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="BlinkAnimationStart" RepeatBehavior="Forever">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="White"/>
                <EasingColorKeyFrame KeyTime="0:0:0.5" Value="DarkOrange"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="BlinkAnimationStop">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                <EasingColorKeyFrame KeyTime="0" Value="White"/>
                <EasingColorKeyFrame KeyTime="0:0:0" Value="White"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
        <DataTemplate x:Key="DefaultRdvDataTemplate" DataType="{x:Type model:RendezVous}">
            <Grid x:Name="GridRdv">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="White" x:Name="BorderRdv">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0"></Setter>
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Blink}" Value="True">
                                    <Setter Property="BorderThickness" Value="3"></Setter>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource BlinkAnimationStart}"/>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource BlinkAnimationStop}"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=GridRdv,Path=DataContext,Converter={StaticResource GetTypeConverter}}" Value="{x:Type model:RendezVous}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Rectangle  Fill="{Binding Status.Brush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"  Height="35" Width="35">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.Status}" Value="Boy">
                                                <Setter Property="Source" Value="{DynamicResource BoyDark}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.Status}" Value="Girl">
                                                <Setter Property="Source" Value="{DynamicResource GirlDark}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.Status}" Value="Man">
                                                <Setter Property="Source" Value="{DynamicResource ManDark}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.Status}" Value="Woman">
                                                <Setter Property="Source" Value="{DynamicResource WomanDark}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding Patient.NumeroDordre}"   Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" TextWrapping="NoWrap"/>
                            <TextBlock Text="{Binding Patient.Nom}"  Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" Foreground="White" FontWeight="Normal" FontFamily="Segoe UI" TextWrapping="NoWrap"/>
                        </Grid>
                    </Grid>

                </Border>
                <Border x:Name="BorderRestDay" Grid.Row="1" Background="Red" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=GridRdv,Path=DataContext,Converter={StaticResource GetTypeConverter}}" Value="{x:Type model:JourFerie}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

        </DataTemplate>
        <DataTemplate DataType="{x:Type model:JourFerie}" x:Key="RestDayDataTemplate">

        </DataTemplate>
        <helpers:RdvDataTemplateSelector x:Key="TemplateSelector"
              DefaultRdvDataTemplate="{StaticResource DefaultRdvDataTemplate}"
              RestDayDataTemplate="{StaticResource RestDayDataTemplate}" 
              />
    </Page.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=CalendarViewLoadedCommand}"
                            PassEventArgsToCommand="True"  />
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=CalendarViewUnLoadedCommand}"
                            PassEventArgsToCommand="True"  />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="grid1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  BorderThickness="1">
                <Grid  syncfusion:DockingManager.State="Document"  
                   syncfusion:DockingManager.Header="Docking Manager" >
                    <syncfusion:SfSchedule MouseLeave="Schedule_OnMouseLeave" ContextMenuOpening="Schedule_OnContextMenuOpening" ShowAppointmentNavigationButtons="True"  ScheduleClick="Schedule_OnScheduleClick"  
                                           x:Name="Schedule"  Appointments="{Binding PatientsScheduleAppointmentCollection,Mode=TwoWay}" 
                                           VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ShowNonWorkingHours="True" Margin="5" ShowAllDay="True"   
                                   ScheduleType="{Binding SelectedScheduleType,Mode=TwoWay}" EnableTouch="False" TimeInterval="ThirtyMin" IntervalHeight="40" AppointmentEditorOpening="Schedule_OnAppointmentEditorOpening" VisibleDatesChanging="Schedule_VisibleDatesChanging">
                        <syncfusion:SfSchedule.NextNavigationButtonTemplate>
                            <DataTemplate>
                                <Button ToolTip="Aller au rdv suivant">
                                    <Path Data="M0,0L768,622.348 0,1244.7 186.312,622.348z" Stretch="Uniform" Fill="Black" Width="26" Height="26" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <TransformGroup.Children>
                                                    <RotateTransform Angle="0" />
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </TransformGroup.Children>
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                            </DataTemplate>
                        </syncfusion:SfSchedule.NextNavigationButtonTemplate>
                        <syncfusion:SfSchedule.PreviousNavigationButtonTemplate>
                            <DataTemplate>
                                <Button ToolTip="Aller au rdv precedant">
                                    <Path Data="M768,0L581.68,622.32 768,1244.7 0,622.32z" Stretch="Uniform" Fill="Black" Width="26" Height="26" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <TransformGroup.Children>
                                                    <RotateTransform Angle="0" />
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </TransformGroup.Children>
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                            </DataTemplate>
                        </syncfusion:SfSchedule.PreviousNavigationButtonTemplate>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="AppointmentEditorOpening">
                                <command:EventToCommand Command="{Binding Mode=OneWay, Path=ScheduleOnAppointmentEditorOpeningCommand}" CommandParameter="{Binding ElementName=Schedule}"
                            PassEventArgsToCommand="True"  />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="AppointmentEndDragging">
                                <command:EventToCommand Command="{Binding Mode=OneWay, Path=AppointmentEndDraggingCommand}"
                            PassEventArgsToCommand="True"  />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <syncfusion:SfSchedule.AppointmentTemplate>
                            <DataTemplate >
                                <Grid x:Name="GridRdv">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>                                        
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="White" x:Name="BorderRdv">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0"></Setter>
