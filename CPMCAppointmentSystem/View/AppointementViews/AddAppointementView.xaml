<controls:MetroWindow x:Class="CPMCAppointmentSystem.View.AppointementViews.AddAppointementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:command="http://www.galasoft.ch/mvvmlight"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:DataLayer.Enums;assembly=DataLayer"
        xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
        WindowStyle="SingleBorderWindow"
                      Title="Ajouter un rendez vous"
                      EnableDWMDropShadow="True"
                      ResizeMode="CanResizeWithGrip"
                      WindowTransitionsEnabled="False"                      
 BorderBrush="{DynamicResource AccentColorBr}"
                      BorderThickness="1"
        WindowStartupLocation="CenterScreen"
                      
                             
         Height="500" Width="700" 
                             DataContext="{Binding Path=CalendarViewModel, Source={StaticResource Locator}}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=AddAppointementViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Grid.Row="0" Width="75" Height="75" Background="#ffeef0ef">
                <Path Data="{StaticResource RdvPath}" Fill="#ff7c7c7c" Width="50" Height="50" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  ></Path>
            </Border>
            <controls:ToggleSwitch VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding SelectedRdv.RdvStateValue,Converter={StaticResource RdvStateValueToBoolConverter},Mode=TwoWay}" Grid.Column="1" HorizontalAlignment="Right" Grid.Row="0"  OnLabel="Activer le rendez-vous" OffLabel="Annuler le rendez-vous">
                <controls:ToggleSwitch.Style>
                    <Style TargetType="controls:ToggleSwitch">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="SelectedRdv.RendezVousId" Converter="{StaticResource IsValueEqualToParameterConverter}" ConverterParameter="{x:Static system:Guid.Empty}"/>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="SelectedRdv.RdvStateValue" Converter="{StaticResource IsValueEqualToParameterConverter}" ConverterParameter="{x:Static enums:RdvState.Passed}"/>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:ToggleSwitch.Style>
            </controls:ToggleSwitch>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="10" x:Name="RootGrid" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Numéro d'ordre" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit  IsEnabled="False" Grid.Column="1" Text="{Binding SelectedRdv.Patient.NumeroDordre,Mode=TwoWay}"  Margin="2 5" HorizontalContentAlignment="Left" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                                     
                                     Watermark="numéro d'ordre"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit IsEnabled="False" Grid.Column="1" Text="{Binding SelectedRdv.Patient.Nom,Mode=TwoWay}"  Margin="2 5" HorizontalContentAlignment="Left" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                                     
                                     Watermark="nom"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit IsEnabled="False" Grid.Column="1" Text="{Binding SelectedRdv.Patient.Prenom,Mode=TwoWay}"  Margin="2 5" HorizontalContentAlignment="Left" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                                     
                                     Watermark="prenom"  
                                     />

                <Expander IsExpanded="False" Header="Selectionez un patient" x:Name="PExpander" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"  HorizontalAlignment="Stretch">
                    <ScrollViewer Width="{Binding ElementName=PExpander,Path=ActualWidth}">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <syncfusion:SfDataGrid Background="WhiteSmoke" Height="250" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="False"
                                       AllowFiltering="True"
                                       AllowGrouping="True"                                    
                                       ItemsSource="{Binding Path=PagedSource,
                                                             ElementName=PatientsDataPager}"
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedRdv.Patient,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <command:EventToCommand Command="{Binding Mode=OneWay, Path=SearchForExistingRdvsCommand}"
                            PassEventArgsToCommand="True" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn HeaderText="Nom" MappingName="Nom" />
                                    <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="Prenom" />
                                    <syncfusion:GridTextColumn HeaderText="Sexe" MappingName="Sexe.Designation"/>
                                    <syncfusion:GridTextColumn HeaderText="Date de naiss" DisplayBinding="{Binding Path=DateDeNaissance,
                                                                            StringFormat=d}"/>
                                    <syncfusion:GridTextColumn HeaderText="Tel" MappingName="TelephoneFixe"/>
                                    <syncfusion:GridTextColumn HeaderText="Mobile 1" MappingName="TelephoneMobile1"/>
                                    <syncfusion:GridTextColumn HeaderText="Mobile 2" MappingName="TelephoneDaccompagnant"/>
                                    <syncfusion:GridTextColumn HeaderText="Willaya" MappingName="Adresse.Willaya.Designation"/>
                                    <syncfusion:GridTextColumn HeaderText="Code Postale" MappingName="Adresse.CodePosatal"/>
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                            <syncfusion:SfDataPager x:Name="PatientsDataPager"
                                       Grid.Row="1"                                       
                                       Height="60"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       AccentBackground="#FF53C3D5"
                                       AccentForeground="White"
                                       NumericButtonCount="10"
                                       Orientation="Horizontal"
                                       PageSize="16"
                                       Source="{Binding AllPatientsCollection}" />
                        </Grid>
                    </ScrollViewer>
                </Expander>
                <TextBlock Grid.Column="0" Grid.Row="4" Text="Date de Rdv" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <DatePicker syncfusion:SkinStorage.VisualStyle="Metro"
                                         Margin="2 5"  SelectedDate="{Binding SelectedRdv.DateTimeRdv ,Mode=TwoWay,StringFormat='{}{0:dd/MM/yyyy}', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"  x:Name="DateEditRdv" 
                                         Grid.Column="1" Grid.Row="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="4"  Text="La date du rendez vous" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=RdvDateBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="0" Grid.Row="5" Text="Lieu de Rdv" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Name="TxtEditLieuRdv"  Grid.Column="1" Text="{Binding SelectedRdv.LieuRdv,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"
                                          Margin="2 5" HorizontalContentAlignment="Left" Grid.Row="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                                     
                                     Watermark="Lieu du rendez vous"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="6" Text="Medecin" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit IsEnabled="False" Grid.Column="1" Text="{Binding SelectedRdv.Medecin.User.UserNom,Mode=TwoWay}"  Margin="2 5" HorizontalContentAlignment="Left" Grid.Row="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                                     
                                     Watermark="Nom et Prenom du medecin"  
                                     />

                <Expander Grid.Column="0" Grid.ColumnSpan="2" Header="Selectionnez un medecin" Grid.Row="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="Gray" Margin="0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock  Margin="5" Text="Qui travail : " Grid.Column="0" FontWeight="DemiBold" Foreground="White" />
                            <RadioButton IsChecked="{Binding ShowSpesificDayDoctors,Mode=TwoWay}"  GroupName="DtrDays" Margin="5"  Content="{Binding SelectedRdv.DateTimeRdv.DayOfWeek,ConverterCulture='Fr-fr' }" HorizontalAlignment="Center" Foreground="White" Grid.Column="1" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked">
                                        <command:EventToCommand Command="{Binding Mode=OneWay, Path=DtrDaysSelectionChangedCommand}"
                            PassEventArgsToCommand="True" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                            <RadioButton  GroupName="DtrDays" Margin="5" Content="Tous les jours" Grid.Column="2" Foreground="White" HorizontalAlignment="Center">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked">
                                        <command:EventToCommand Command="{Binding Mode=OneWay, Path=DtrDaysSelectionChangedCommand}"
                            PassEventArgsToCommand="True" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                        </Grid>
                        <syncfusion:SfDataGrid Background="WhiteSmoke" Grid.Row="1" Height="250" SelectionMode="Single"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                           ColumnSizer="Star"
                                       AllowEditing="False"
                                       AllowFiltering="True"
                                       AllowGrouping="True"                                   
                                       ItemsSource="{Binding ElementName=DoctorDataPager,Path=PagedSource}"
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedRdv.Medecin}"
                                       ShowGroupDropArea="True" >

                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn HeaderText="Nom" MappingName="User.UserNom" />
                                <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="User.UserPrenom" />
                                <syncfusion:GridTextColumn HeaderText="Mobile" MappingName="TelephoneMobile"/>
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                        <syncfusion:SfDataPager x:Name="DoctorDataPager"
                                       Grid.Row="2"                                       
                                       Height="60"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       AccentBackground="#FF53C3D5"
                                       AccentForeground="White"
                                       NumericButtonCount="10"
                                       Orientation="Horizontal"
                                       PageSize="16"
                                       Source="{Binding AllDoctorsCollection,Mode=TwoWay}" />
                    </Grid>
                </Expander>



            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2" Grid.Column="0"  VerticalAlignment="Bottom" Margin="5" IsEnabled="{Binding ConnectedUser.RolesCollection.AppointementEditAllow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"  Margin="2" Command="{Binding SaveAppointementCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                        <TextBlock Text="Save" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="IsEnabled" Value="false" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=TxtEditLieuRdv, Path=(Validation.HasError)}" Value="false" />
                                    <Condition Binding="{Binding ElementName=DateEditRdv, Path=(Validation.HasError)}" Value="false" />
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="DataContext.SelectedRdv.Patient" ElementName="RootGrid" Converter="{StaticResource IsValueEqualToParameterConverter}">
                                                <Binding.ConverterParameter>
                                                    <x:Null/>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="DataContext.SelectedRdv.Medecin" ElementName="RootGrid" Converter="{StaticResource IsValueEqualToParameterConverter}">
                                                <Binding.ConverterParameter>
                                                    <x:Null/>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="true" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="1"  Margin="2" Command="{Binding DeleteAppointementCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                        <TextBlock Text="Delete" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedRdv.RendezVousId}" Value="{x:Static system:Guid.Empty}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2"  Margin="2" Command="{Binding CancelAppointementChangesCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                        <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>

</controls:MetroWindow>
