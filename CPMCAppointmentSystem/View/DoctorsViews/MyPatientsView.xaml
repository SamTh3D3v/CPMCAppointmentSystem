<Page x:Class="CPMCAppointmentSystem.View.DoctorsViews.MyPatientsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:enums="clr-namespace:DataLayer.Enums;assembly=DataLayer"
      mc:Ignorable="d" 
     d:DesignHeight="700" d:DesignWidth="800" DataContext="{Binding Source={StaticResource Locator},Path=PatientsViewModel}"
	Title="MyPatientsView">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=LoadConnectedDoctorPatientsCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource NavigationPanelBackgroundBrush}">
            <!--the list of patients Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="20,0,0,0" Text="Patients" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="0" />
            <ToggleButton x:Name="FilterTb" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"  Width="25" Height="25" Padding="0" Margin="5,0,0,0">
                <Image Source="{StaticResource FilterDark}"></Image>
            </ToggleButton>
            <!--<Button Grid.Row="0" IsEnabled="False" Grid.Column="2"  Margin="10" Command="{Binding AddPatientCommand}" ToolTip="Show filter">
                <Button.Content>
                    <Image Source="{StaticResource AddNewDark}" Width="40" Height="40" ></Image>
                </Button.Content>
            </Button>-->
            <Rectangle Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=FilterTb,Path=IsChecked}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=FilterTb,Path=IsChecked}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <syncfusion:SfTextBoxExt Grid.Row="0" Grid.Column="0" Text="{Binding ListPatientsFilterText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2 5"                                      
                                     Watermark="Filtrer les patients"  
                                     >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <command:EventToCommand Command="{Binding Mode=OneWay, Path=StartSearchServiceCommand}"
                            PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </syncfusion:SfTextBoxExt>
                <!--<ComboBox Grid.Row="0"  Grid.Column="1" Margin="2 5" x:Name="FiltrerParBox" ItemsSource="{Binding FilterByCollection}" SelectedItem="{Binding FilterBySelectedItem,Mode=TwoWay}"/>
                <TextBlock Grid.Row="0"  Grid.Column="1"  Text="Par" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=FiltrerParBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Row="0"  Grid.Column="2"  Margin="2 5" x:Name="PieceJTypeBox" ItemsSource="{Binding TypePieceJointeList}" DisplayMemberPath="PieceJointeTitle" SelectedItem="{Binding SelectedTypePieceJointeInFilter,Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=FiltrerParBox,Path=SelectedValue}" Value="Piece Jointe">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Grid.Row="0"  Grid.Column="2"  Text="Type" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=PieceJTypeBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=PieceJTypeBox}" Value="Collapsed">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>-->
                <Grid  Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Date de dépot" Grid.Column="0" VerticalAlignment="Center"/>
                    <DatePicker  Grid.Column="1" SelectedDate="{Binding DateDepotFilter,StringFormat='{}{0:dd/MM/yyyy}',Mode=TwoWay}"  x:Name="DateDepotBoxTimeEdit"  Margin="10,5,0,4"  HorizontalAlignment="Stretch" >
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedDateChanged">
                                <command:EventToCommand Command="{Binding Mode=OneWay, Path=SelectedDateFilterChangedCommand}"
                            PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <DatePicker.Style>
                            <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=DateDepotCb,Path=IsChecked}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=DateDepotCb,Path=IsChecked}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>
                    </DatePicker>
                    <CheckBox Grid.Column="2" x:Name="DateDepotCb" IsChecked="{Binding IsDateDepotFilterApplied,Mode=TwoWay}" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <command:EventToCommand Command="{Binding Mode=OneWay, Path=UpdateBasedOnDateDepotFilterCommand}"
                            PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="Unchecked">
                                <command:EventToCommand Command="{Binding Mode=OneWay, Path=UpdateBasedOnDateDepotFilterCommand}"
                            PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </CheckBox>
                </Grid>
            </Grid>
            <syncfusion:SfDataGrid  Grid.Column="0"  Grid.ColumnSpan="3"  Grid.Row="3" Name="sfgrid"                                      
                                       AllowEditing="False"                                       
                                       AllowGrouping="True" 
                                    SelectionMode="Single"                                    
                                       ItemsSource="{Binding PatientList}"
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedPatient,Mode=TwoWay}"
                                       ShowGroupDropArea="True"                                                                          
                                    RowStyle="{StaticResource PatientRowStyle}" >

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="Nom" MappingName="Nom"/>
                    <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="Prenom" />
                    <syncfusion:GridTextColumn HeaderText="Field" MappingName="Field.Designation"/>
                    <syncfusion:GridTextColumn HeaderText="Date de naiss" DisplayBinding="{Binding Path=DateDeNaissance,
                                                                            StringFormat='{}{0:dd/MM/yyyy}'}"/>
                    <syncfusion:GridTextColumn HeaderText="Télephone fixe" MappingName="TelephoneFixe"/>
                    <syncfusion:GridTextColumn HeaderText="Mobile 1" MappingName="TelephoneMobile1"/>
                    <syncfusion:GridTextColumn HeaderText="Mobile 2" MappingName="TelephoneDaccompagnant"/>
                    <syncfusion:GridTextColumn HeaderText="Willaya" MappingName="Adresse.Willaya.Designation"/>
                    <syncfusion:GridTextColumn HeaderText="Code Postal" MappingName="Adresse.CodePosatal"/>
                    <syncfusion:GridTextColumn HeaderText="Pathologie" MappingName="Pathology.NomPathology"/>
                </syncfusion:SfDataGrid.Columns>
                <syncfusion:SfDataGrid.RecordContextMenu>
                    <ContextMenu >
                        <MenuItem Command="{Binding Source={StaticResource Locator},Path=PatientsViewModel.PatientDeadCommand}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=PatientsViewModel.SelectedPatient.Dead,Source={StaticResource Locator}}" Value="False">
                                            <Setter Property="Header" Value="marker dead"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=PatientsViewModel.SelectedPatient.Dead,Source={StaticResource Locator}}" Value="True">
                                            <Setter Property="Header" Value="marker alive"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                            <MenuItem.Icon>
                                <Path Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource DeathPath}"
                                          Fill="#FF5A5A5B"
                                          Stretch="Fill" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </syncfusion:SfDataGrid.RecordContextMenu>
            </syncfusion:SfDataGrid>

        </Grid>
        <GridSplitter Grid.Column="1" Width="1" Background="LightGray" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2" Background="{StaticResource BodyBackgroundBrush}" DataContext="{Binding SelectedPatient,Mode=TwoWay}" IsEnabled="{Binding DataContext.IsFormEnabled,RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <!--the patients details Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,10,5,2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Image x:Name="WebCamPic" Source="{StaticResource FaceDark}" Grid.Column="0" Grid.Row="0" Width="75"/>
                <Border Grid.Column="0" Grid.Row="0" Width="80" Height="80" Padding="2" BorderBrush="Gray" BorderThickness="2">
                    <Image Stretch="UniformToFill" x:Name="ProfileImage"  Source="{Binding ProfilePicture}"  Width="75" Height="75" />
                </Border>
                <Border x:Name="WebCamBorder" Background="Transparent" Grid.Column="0" Grid.Row="0" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value=".01"></Setter>
                            <Style.Triggers>
                                <Trigger  Property="IsMouseOver"  Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid >
                        <Button ToolTip="Ajouter image" Background="WhiteSmoke" Style="{DynamicResource MetroCircleButtonStyle}" Command="{Binding DataContext.LoadPatientImageCommand,ElementName=RootGrid}">
                            <Path Data="M31.478432,15.239C36.687607,15.239 40.906941,19.457997 40.906941,24.661992 40.906941,29.865988 36.687607,34.085986 31.478432,34.085986 26.279251,34.085986 22.059918,29.865988 22.059918,24.661992 22.059918,19.457997 26.279251,15.239 31.478432,15.239z M31.425879,9.8389888C23.416933,9.8389888 16.88777,16.362975 16.88777,24.379973 16.88777,32.394988 23.416933,38.916991 31.425879,38.916991 39.444832,38.916991 45.963986,32.394988 45.963986,24.379973 45.963986,16.362975 39.444832,9.8389888 31.425879,9.8389888z M43.904202,0C45.124008,-2.9131115E-08,46.113869,0.98797598,46.113869,2.205993L46.113869,4.8519898C46.113869,4.9059749,46.103981,4.9589839,46.103981,5.013L49.523449,5.013C51.613137,5.013,53.333,6.7279964,53.333,8.8219905L53.333,39.297972C53.333,41.392973,51.613137,43.108,49.523449,43.108L3.8095522,43.108C1.7198642,43.108,0,41.392973,0,39.297972L0,8.8219905C0,6.7279964,1.7198642,5.013,3.8095522,5.013L5.6292574,5.013C5.6192486,4.9459834,5.6192486,4.8799739,5.6192486,4.8109741L5.6192486,3.6089783C5.6192486,1.836975,7.0491121,0.40100091,8.8188965,0.40100085L22.057127,0.40100085C23.826912,0.40100091,25.266663,1.836975,25.266663,3.6089783L25.266663,4.8109741C25.266663,4.8799739,25.256653,4.9459834,25.246645,5.013L41.71455,5.013C41.70454,4.9589839,41.70454,4.9059749,41.70454,4.8519898L41.70454,2.205993C41.70454,1.8799743,41.774479,1.5699767,41.904465,1.2909849L41.904465,1.2019956 41.9445,1.2019956C42.314446,0.48999017,43.054337,-2.9131115E-08,43.904202,0z" Stretch="Uniform" Fill="#FF000000" Width="30" Height="30" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5"/>
                        </Button>
                    </Grid>
                </Border>


                <Grid Grid.Row="0" Grid.Column="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button  ToolTip="Supprimer Image" Name="BtnDeletePic" VerticalAlignment="Top" Background="WhiteSmoke"  Command="{Binding DataContext.DeletePatientImageCommand,ElementName=RootGrid}" Grid.Column="0" Width="30" Height="30">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MetroCircleButtonStyle}">
                                <Setter Property="IsEnabled" Value="True"></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ProfileImage,Path=Source}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource DeletePath}" Stretch="Uniform"  Width="10" Height="10" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="LightGray"></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=RootGrid,Path=DataContext.IsFormEnabled}" Value="True">
                                            <Setter Property="Fill" Value="Black"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <ToggleButton Name="TbPatDead" IsChecked="{Binding Dead,Mode=TwoWay}"  ToolTip="Patient décédé" VerticalAlignment="Bottom"  Grid.Column="0" Width="40" Height="40">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MetroCircleToggleButtonStyle}">
                                <Setter Property="Background" Value="WhiteSmoke"></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=TbPatDead,Path=IsChecked}" Value="True">
                                        <Setter Property="Background" Value="Red"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <Path Data="{StaticResource DeathPath}" Stretch="Uniform"  Width="15" Height="15" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="LightGray"></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TbPatDead,Path=IsChecked}" Value="True">
                                            <Setter Property="Fill" Value="White"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding CarteProfessionel,Mode=TwoWay}" x:Name="CardProButton" Width="60" Height="60" ToolTip="Ajouter image" Background="WhiteSmoke" Style="{DynamicResource MetroCircleToggleButtonStyle}" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right">
                        <Path Data="M11.961001,32.591001L27.961,32.591001 27.961,38.352 11.961001,38.352z M41.431141,29.375001L46.286661,29.375001C51.203279,29.375001,55.316496,33.104243,56.395998,38.112L31.323,38.112C32.403814,33.104243,36.513142,29.375001,41.431141,29.375001z M11.961001,22.992001L27.961,22.992001 27.961,28.751 11.961001,28.751z M43.85944,14.016001C47.470053,14.016001 50.393,16.945526 50.393,20.549741 50.393,24.159045 47.470053,27.086 43.85944,27.086 40.250229,27.086 37.326,24.159045 37.326,20.549741 37.326,16.945526 40.250229,14.016001 43.85944,14.016001z M11.961001,13.39L27.961,13.39 27.961,19.151 11.961001,19.151z M6.4470005,6.6650009L6.4470005,45.109001 57.779001,45.109001 57.779001,6.6650009z M0,0L64.000002,0 64.000002,51.331001 0,51.331001z" Stretch="Uniform"  Width="30" Height="30" Margin="0,0,0,0" >
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="LightGray"></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=CardProButton,Path=IsChecked}" Value="True">
                                            <Setter Property="Fill" Value="White"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                </Grid>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Num D'ordre" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfTextBoxExt Name="TxtEditNumOrdre" Grid.Column="1" Text="{Binding NumeroDordre,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Numero d'ordre"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfTextBoxExt Name="TxtEditNom" Grid.Column="1" Text="{Binding Nom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Nom"  
                                     />


                <TextBlock Grid.Column="0" Grid.Row="3" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfTextBoxExt Name="TxtEditPrenom" Grid.Column="1" Text="{Binding Prenom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Prenom"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="4" Text="Date de naiss" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <DatePicker Name="DateTimeNaiss" Margin="10 5"  SelectedDate="{Binding DateDeNaissance,Mode=TwoWay,StringFormat='{}{0:dd/MM/yyyy}',UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"  Grid.Column="1" Grid.Row="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="4"  Text="Date de naissance" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=BirthDateBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="0" Grid.Row="5" Text="Field" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:ComboBoxAdv syncfusion:SkinStorage.VisualStyle="Metro" Name="CbxSexe" Margin="10 5" ItemsSource="{Binding DataContext.SexeList,RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding Path=Sexe,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" DisplayMemberPath="Designation" Grid.Column="1" Grid.Row="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="5"  Text="Field" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=CbxSexe}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="0" Grid.Row="6" Text="Telephone Fixe" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfTextBoxExt Name="TxtEditTelFix" Grid.Column="1" Text="{Binding TelephoneFixe,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Telephone fixe"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="7" Text="Mobile 1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfTextBoxExt Name="TxtEditMobile" Grid.Column="1" Text="{Binding TelephoneMobile1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="7" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Telephone mobile"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="8" Text="Mobile d'accomp" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfTextBoxExt Name="TxtEditMobileAcc" Grid.Column="1" Text="{Binding TelephoneDaccompagnant,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Telephone mobile d'accompagnateur"  
                                     />
                <TextBlock Grid.Column="0" Grid.Row="9" Text="Nom d'accomp" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfTextBoxExt Name="TxtEditNomAcc" Grid.Column="1" Text="{Binding NomPrenomDaccompagnant,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="9" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Nom et prenom d'accompagnateur"  
                                     />

