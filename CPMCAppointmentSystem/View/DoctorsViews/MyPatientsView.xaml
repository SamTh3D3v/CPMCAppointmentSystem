                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource PreviewDark}" Width="20" Height="20" />
                                                    <TextBlock Text="Preview" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                        <Button Grid.Column="1"  Margin="2" Command="{Binding ElementName=RootGrid,Path=DataContext.PrintRdvCommand}">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource Printer2Dark}" Width="20" Height="20" />
                                                    <TextBlock Text="Imprimer" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>

                                    </Grid>
                                </GroupBox>

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>

                    <syncfusion:TabItemExt  MinHeight="35" x:Name="NotesTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Notes"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding DataContext.AddNewNoteCommand,ElementName=RootGrid}" IsEnabled="{Binding DataContext.ConnectedUserRollsCollection.MyPatientsEditAllow,ElementName=RootGrid}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Note" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Nouveau">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <syncfusion:SfTextBoxExt  Name="TxtEditTitre" Text="{Binding ElementName=RootGrid,Path=DataContext.SelectedNote.Title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Titre du note"  />
                                        <syncfusion:SfTextBoxExt AcceptsReturn="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Name="TxtEditContenu" Text="{Binding ElementName=RootGrid,Path=DataContext.SelectedNote.Content,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"  Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Contenu du note" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"  Margin="10 5" Command="{Binding ElementName=RootGrid,Path=DataContext.DeleteNoteCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=RootGrid,Path=DataContext.SelectedNote.NoteId}" Value="{x:Static system:Guid.Empty}">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=RootGrid,Path=DataContext.SelectedNote}" Value="{x:Null}">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Content>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                                        <TextBlock Text="delete" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button.Content>
                                            </Button>
                                            <Button Grid.Column="1"  Margin="10 5" Command="{Binding ElementName=RootGrid,Path=DataContext.SaveNewNoteCommand}" IsEnabled="{Binding DataContext.ConnectedUserRollsCollection.MyPatientsEditAllow,ElementName=RootGrid}">
                                                <Button.Content>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                                        <TextBlock Text="save" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="IsEnabled" Value="false" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=TxtEditTitre, Path=(Validation.HasError)}" Value="false" />
                                                                    <Condition Binding="{Binding ElementName=TxtEditContenu, Path=(Validation.HasError)}" Value="false" />
                                                                    <Condition>
                                                                        <Condition.Binding>
                                                                            <Binding Path="DataContext.SelectedNote" ElementName="RootGrid" Converter="{StaticResource IsValueEqualToParameterConverter}">
                                                                                <Binding.ConverterParameter>
                                                                                    <x:Null/>
                                                                                </Binding.ConverterParameter>
                                                                            </Binding>
                                                                        </Condition.Binding>
                                                                        <Condition.Value>
                                                                            <system:Boolean>False</system:Boolean>
                                                                        </Condition.Value>
                                                                    </Condition>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="IsEnabled" Value="true" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
                                <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"  Header="List des notes">
                                    <ListView ItemsSource="{Binding Path=DataContext.SelectedPatient.Notes,ElementName=RootGrid}" SelectedItem="{Binding ElementName=RootGrid,Path=DataContext.SelectedNote}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="Black" BorderThickness="1" Margin="5">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
                                                    </Grid>
                                                </Border>

                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </GroupBox>

                            </Grid>

                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>


                    <!--<Syncfusion:TabControlExt.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ItemTemplate>
                    <Syncfusion:TabControlExt.ContentTemplate>
                        <DataTemplate>
                            <local:Weather BorderBrush="{Binding ElementName=options, Path=BorderBrush}" x:Name="weather"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ContentTemplate>-->
                </syncfusion:TabControlExt>
            </Grid>


        </Grid>
    </Grid>
</Page>
