<controls:MetroWindow x:Class="CPMCAppointmentSystem.View.DoctorsViews.AddPatientsToDoctorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:command="http://www.galasoft.ch/mvvmlight"
        xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        Height="500" Width="700" 
                      Title="Affecte des patients a un medecin"
                      WindowStyle="SingleBorderWindow"
                      EnableDWMDropShadow="True"
                      ResizeMode="CanResizeWithGrip"
                      WindowTransitionsEnabled="False"                      
 BorderBrush="{DynamicResource AccentColorBr}"
                      BorderThickness="1"
        WindowStartupLocation="CenterScreen"
                             DataContext="{Binding Path=DoctorsViewModel, Source={StaticResource Locator}}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=AddPatientsToDoctorLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid  Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Source="{StaticResource FaceDark}" Grid.Column="0" Grid.Row="0" Width="75"/>


        <TextBlock Grid.Column="0" Grid.Row="1" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
        <Syncfusion:SfMaskedEdit Margin="10 5"  x:Name="NomBox" IsEnabled="False" Text="{Binding SelectedDoctor.User.UserNom,Mode=TwoWay}" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>


        <TextBlock Grid.Column="0" Grid.Row="2" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
        <Syncfusion:SfMaskedEdit Margin="10 5" x:Name="PrenomBox" IsEnabled="False" Text="{Binding SelectedDoctor.User.UserPrenom}" Grid.Column="1" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

        <Expander IsExpanded="True" x:Name="PExpander" Margin="5" Grid.Column="0" Grid.ColumnSpan="2"
                  Grid.Row="3" Header="Selectionnez les patients"  HorizontalAlignment="Stretch">
            <Grid Margin="2" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Syncfusion:SfDataGrid SelectionMode="Multiple" Margin="2" Grid.Row="0" Background="WhiteSmoke"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"                                           
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"                                   
                                       ItemsSource="{Binding ElementName=PatientsToAddDataPager,Path=PagedSource}"
                                       AutoGenerateColumns="False"                                   
                                       ShowGroupDropArea="True" >

                    <Syncfusion:SfDataGrid.Columns>
                        <Syncfusion:GridTextColumn HeaderText="NumeroDordre" MappingName="Entity.Nom" AllowEditing="False"/>
                        <Syncfusion:GridTextColumn HeaderText="Nom" MappingName="Entity.Prenom" AllowEditing="False"/>
                        <Syncfusion:GridTextColumn HeaderText="Prenom" MappingName="Entity.TelephoneMobile" AllowEditing="False"/>
                        <Syncfusion:GridTextColumn HeaderText="Sexe" MappingName="Entity.Sexe.Designation" AllowEditing="False"/>
                        <Syncfusion:GridTextColumn HeaderText="Mobile" MappingName="Entity.TelephoneMobile" AllowEditing="False"/>
                        <Syncfusion:GridTextColumn HeaderText="Pathology" MappingName="Entity.Pathology.NomPathology" AllowEditing="False"/>
                        <Syncfusion:GridCheckBoxColumn HeaderText="Ajouter" AllowEditing="True" MappingName="IsAdded" />
                    </Syncfusion:SfDataGrid.Columns>
                </Syncfusion:SfDataGrid>
                <Syncfusion:SfDataPager x:Name="PatientsToAddDataPager" HorizontalContentAlignment="Right"
                                       Grid.Row="1"                                                                                                                      
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Top"
                                       AccentBackground="#FF53C3D5"
                                       AccentForeground="White"
                                       NumericButtonCount="10"
                                       Orientation="Horizontal"
                                       PageSize="16"
                                       Source="{Binding PatientsToAddList}" />
            </Grid>
        </Expander>

        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"  Margin="2" Command="{Binding SavePatientsToDoctorsViewCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                        <TextBlock Text="Save" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Column="1"  Margin="2" Command="{Binding CancelPatientsToDoctorsViewCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                        <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</controls:MetroWindow>
