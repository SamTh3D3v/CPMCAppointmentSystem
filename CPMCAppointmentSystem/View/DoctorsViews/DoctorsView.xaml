<Page x:Class="CPMCAppointmentSystem.View.DoctorsViews.DoctorsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:model="clr-namespace:DataLayer.Model;assembly=DataLayer"
      mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="800" DataContext="{Binding Source={StaticResource Locator},Path=DoctorsViewModel}"
	Title="DoctorsView">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=DoctorsViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=DoctorsViewUnLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource NavigationPanelBackgroundBrush}">
            <!--the list of patients Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="20,0,0,0" Text="Medecins" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="0" />
            <Button Grid.Row="0" Grid.Column="1"  Margin="10" Command="{Binding AddDoctorCommand}" Click="ButtonBase_OnClick">
                <Button.Content>
                    <Image Source="{StaticResource AddNewDark}" Width="40" Height="40" ></Image>
                </Button.Content>
            </Button>
            <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
            <syncfusion:SfDataGrid  Grid.Column="0" Grid.ColumnSpan="2" AutoGenerateColumns="False" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="sfgrid"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding DoctorsList}"
                                   SelectedItem="{Binding SelectedDoctor,Mode=TwoWay}"
                                       ShowGroupDropArea="True"
                                    SelectionChanged="SfDataGrid_OnSelectionChanged">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="Nom" MappingName="User.UserNom" />
                    <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="User.UserPrenom" />
                    <syncfusion:GridTextColumn HeaderText="Mobile" MappingName="TelephoneMobile"/>
                    <syncfusion:GridTextColumn HeaderText="Fixe" MappingName="TelephoneFixe"/>
                    <syncfusion:GridTextColumn HeaderText="Date de naiss" DisplayBinding="{Binding Path=DateDeNaissance,
                                                                           StringFormat=d}"/>


                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

        </Grid>
        <GridSplitter Grid.Column="1" Width="1" Background="LightGray" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2" Background="{StaticResource BodyBackgroundBrush}" IsEnabled="{Binding IsFormEnabled}">
            <!--the patients details Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,20" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <Image x:Name="WebCamPic" Source="{StaticResource DoctorDark}" Grid.Column="0" Grid.Row="0" Width="75"/>
                <Border Grid.Column="0" Grid.Row="0" Width="80" Height="80" Padding="2" BorderBrush="Gray" BorderThickness="2">
                    <Image Stretch="UniformToFill" x:Name="ProfileImage"  Source="{Binding SelectedDoctor.ProfilePicture}"  Width="75" Height="75" />
                </Border>
                <Border x:Name="WebCamBorder" Background="Transparent" Grid.Column="0" Grid.Row="0" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value=".01"></Setter>
                            <Style.Triggers>
                                <Trigger  Property="IsMouseOver"  Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid >
                        <Button ToolTip="Ajouter image" Background="WhiteSmoke" Style="{DynamicResource MetroCircleButtonStyle}" Command="{Binding DataContext.LoadDoctorImageCommand,ElementName=RootGrid}">
                            <Path Data="M31.478432,15.239C36.687607,15.239 40.906941,19.457997 40.906941,24.661992 40.906941,29.865988 36.687607,34.085986 31.478432,34.085986 26.279251,34.085986 22.059918,29.865988 22.059918,24.661992 22.059918,19.457997 26.279251,15.239 31.478432,15.239z M31.425879,9.8389888C23.416933,9.8389888 16.88777,16.362975 16.88777,24.379973 16.88777,32.394988 23.416933,38.916991 31.425879,38.916991 39.444832,38.916991 45.963986,32.394988 45.963986,24.379973 45.963986,16.362975 39.444832,9.8389888 31.425879,9.8389888z M43.904202,0C45.124008,-2.9131115E-08,46.113869,0.98797598,46.113869,2.205993L46.113869,4.8519898C46.113869,4.9059749,46.103981,4.9589839,46.103981,5.013L49.523449,5.013C51.613137,5.013,53.333,6.7279964,53.333,8.8219905L53.333,39.297972C53.333,41.392973,51.613137,43.108,49.523449,43.108L3.8095522,43.108C1.7198642,43.108,0,41.392973,0,39.297972L0,8.8219905C0,6.7279964,1.7198642,5.013,3.8095522,5.013L5.6292574,5.013C5.6192486,4.9459834,5.6192486,4.8799739,5.6192486,4.8109741L5.6192486,3.6089783C5.6192486,1.836975,7.0491121,0.40100091,8.8188965,0.40100085L22.057127,0.40100085C23.826912,0.40100091,25.266663,1.836975,25.266663,3.6089783L25.266663,4.8109741C25.266663,4.8799739,25.256653,4.9459834,25.246645,5.013L41.71455,5.013C41.70454,4.9589839,41.70454,4.9059749,41.70454,4.8519898L41.70454,2.205993C41.70454,1.8799743,41.774479,1.5699767,41.904465,1.2909849L41.904465,1.2019956 41.9445,1.2019956C42.314446,0.48999017,43.054337,-2.9131115E-08,43.904202,0z" Stretch="Uniform" Fill="#FF000000" Width="30" Height="30" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5"/>
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Row="0" Grid.Column="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button  ToolTip="Supprimer cette Image" VerticalAlignment="Top" Background="WhiteSmoke"  Command="{Binding DataContext.DeleteDoctorImageCommand,ElementName=RootGrid}" Grid.Column="0" Width="30" Height="30">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MetroCircleButtonStyle}">
                                <Setter Property="IsEnabled" Value="True"></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ProfileImage,Path=Source}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M33.977998,27.684L33.977998,58.102997 41.373998,58.102997 41.373998,27.684z M14.841999,27.684L14.841999,58.102997 22.237998,58.102997 22.237998,27.684z M4.0319996,22.433001L52.183,22.433001 52.183,63.999001 4.0319996,63.999001z M15.974,0L40.195001,0 40.195001,7.7260003 56.167001,7.7260003 56.167001,16.000999 0,16.000999 0,7.7260003 15.974,7.7260003z" Stretch="Uniform" Fill="#FF000000" Width="10" Height="10" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5"/>
                    </Button>
                </Grid>

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Watermark="Nom" x:Name="TxtEditNom" Grid.Column="1" Text="{Binding SelectedDoctor.User.UserNom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="1" />


                <TextBlock Grid.Column="0" Grid.Row="2" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit x:Name="TexEditPrenom"   Watermark="Prenom" Grid.Column="1" Text="{Binding SelectedDoctor.User.UserPrenom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="2" />

                <TextBlock Grid.Column="0" Grid.Row="3" Text="TelephoneFixe" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Watermark="Telephone fixe"  x:Name="TexEditTelFix" Grid.Column="1" Text="{Binding SelectedDoctor.TelephoneFixe,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="3"/>

                <TextBlock Grid.Column="0" Grid.Row="4" Text="Mobile" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Watermark="Telephone mobile"  x:Name="TexEditMobile" Grid.Column="1" Grid.Row="4" Text="{Binding SelectedDoctor.TelephoneMobile,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" />

                <!--<TextBlock Grid.Column="0" Grid.Row="5" Text="Spécialité" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,156,10" Grid.ColumnSpan="2"/>
                <ComboBox x:Name="CbxSpeciality" IsEnabled="False" Margin="10 5" ItemsSource="{Binding SpecialitiesList}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDoctor.SpecialitePrincipale,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Column="1" Grid.Row="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Margin="10 5" Grid.Row="5"  Text="Spécialité" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=CbxSpeciality}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>-->

                <TextBlock Grid.Column="0" Grid.Row="6" Text="Jours de travail" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <ScrollViewer Grid.Column="1" Grid.Row="6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Margin="10 5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Width="35" Content="S" IsChecked="{Binding SelectedDoctor.JoursDeTravail,Converter={StaticResource FlagToIsCheckedConverter},ConverterParameter={x:Static model:Days.Saturday},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" ToolTip="Samedi" Grid.Column="0" Height="35" Margin="2" Style="{DynamicResource MetroCircleToggleButtonStyle}" Name="TbJourDeTravail"/>
                        <ToggleButton Width="35" Content="D" IsChecked="{Binding SelectedDoctor.JoursDeTravail,Converter={StaticResource FlagToIsCheckedConverter},ConverterParameter={x:Static model:Days.Sunday},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" ToolTip="Dimanche" Grid.Column="1" Height="35" Margin="2" Style="{DynamicResource MetroCircleToggleButtonStyle}"/>
                        <ToggleButton Width="35" Content="L" IsChecked="{Binding SelectedDoctor.JoursDeTravail,Converter={StaticResource FlagToIsCheckedConverter},ConverterParameter={x:Static model:Days.Monday},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" ToolTip="Lundi" Grid.Column="2" Height="35" Margin="2" Style="{DynamicResource MetroCircleToggleButtonStyle}"/>
                        <ToggleButton Width="35" Content="M" IsChecked="{Binding SelectedDoctor.JoursDeTravail,Converter={StaticResource FlagToIsCheckedConverter},ConverterParameter={x:Static model:Days.Tuesday},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" ToolTip="Mardi" Grid.Column="3" Height="35" Margin="2" Style="{DynamicResource MetroCircleToggleButtonStyle}"/>
                        <ToggleButton Width="35" Content="M" IsChecked="{Binding SelectedDoctor.JoursDeTravail,Converter={StaticResource FlagToIsCheckedConverter},ConverterParameter={x:Static model:Days.Wednesday},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" ToolTip="Mercredi" Grid.Column="4" Height="35" Margin="2" Style="{DynamicResource MetroCircleToggleButtonStyle}"/>
                        <ToggleButton Width="35" Content="J" IsChecked="{Binding SelectedDoctor.JoursDeTravail,Converter={StaticResource FlagToIsCheckedConverter},ConverterParameter={x:Static model:Days.Thursday},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" ToolTip="Jeudi" Grid.Column="5" Height="35" Margin="2" Style="{DynamicResource MetroCircleToggleButtonStyle}"/>
                        <ToggleButton Width="35" Content="V" IsChecked="{Binding SelectedDoctor.JoursDeTravail,Converter={StaticResource FlagToIsCheckedConverter},ConverterParameter={x:Static model:Days.Friday},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" ToolTip="Vendredi" Grid.Column="6" Height="35" Margin="2" Style="{DynamicResource MetroCircleToggleButtonStyle}"/>
                    </Grid>
                </ScrollViewer>

                <GroupBox  Margin="0,20,0,0" Grid.Row="8" Grid.Column="0"  Grid.ColumnSpan="2">
                    <GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Données de connection" Grid.Column="0" HorizontalAlignment="Left"/>
                        </Grid>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Nom d'utilisateur" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <syncfusion:SfMaskedEdit Watermark="Nom d'utilisateur"  x:Name="TxtEditUserName" Grid.Column="1" Grid.Row="0" Text="{Binding SelectedDoctor.User.UserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"/>
                        <Expander  Grid.Row="1" Style="{StaticResource {x:Type Expander}}" Grid.Column="0" Grid.ColumnSpan="2">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MoT De Passe" HorizontalAlignment="Left" Foreground="White"/>
                                    <CheckBox x:Name="CbUpdatePass" Grid.Column="2" HorizontalAlignment="Right" Unchecked="PassCheckBox_OnUnChecked" Checked="PassCheckBox_OnChecked">
                                        <CheckBox.Style>
                                            
                                            <Style TargetType="CheckBox">
                                                <Setter Property="IsChecked" Value="False"/>
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Setter Property="Content" Value="changer"></Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDoctor.MedecinId}" Value="{x:Static system:Guid.Empty}">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Content" Value="saisir"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </Grid>
                            </Expander.Header>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=CbUpdatePass,Path=IsChecked}" Value="True" >
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Nouveau password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>

                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Confirmé password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                <PasswordBox Margin="10 5" Grid.Column="1"  Grid.Row="0" x:Name="PassBoxUserPass" Style="{DynamicResource  WaterMarkPasswordBoxStyle}"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" PasswordChanged="UserPass_OnPasswordChanged">
                                    <PasswordBox.Resources>
                                        <system:String x:Key="WaterMarkText">Enter password</system:String>
                                    </PasswordBox.Resources>
                                </PasswordBox>
                                <PasswordBox Margin="10 5" Grid.Column="1" Grid.Row="1"  x:Name="PassBoxConfirmPass" Style="{DynamicResource  WaterMarkPasswordBoxStyle}"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  PasswordChanged="UserPass_OnPasswordChanged">
                                    <PasswordBox.Resources>
                                        <system:String x:Key="WaterMarkText">Confirme password</system:String>
                                    </PasswordBox.Resources>
                                </PasswordBox>
                            </Grid>
                        </Expander>
                    </Grid>
                </GroupBox>


                <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Tag="no" Grid.Column="0"  Margin="2" Command="{Binding SaveDoctorCommand}" x:Name="BuSave">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                <TextBlock Text="Save" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="false" />
                                <Style.Triggers>                                    
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ElementName=TxtEditNom, Path=(Validation.HasError)}" Value="false" />
                                            <Condition Binding="{Binding ElementName=TexEditPrenom, Path=(Validation.HasError)}" Value="false" />
                                            <Condition Binding="{Binding ElementName=TexEditTelFix, Path=(Validation.HasError)}" Value="false" />
                                            <Condition Binding="{Binding ElementName=TexEditMobile, Path=(Validation.HasError)}" Value="false" />
                                            <Condition Binding="{Binding ElementName=TbJourDeTravail, Path=(Validation.HasError)}" Value="false" />
                                            <Condition Binding="{Binding ElementName=TxtEditUserName, Path=(Validation.HasError)}" Value="false" />                                                                                        
                                            <Condition>
                                                <Condition.Binding>
                                                    <Binding Path="SelectedDoctor" Converter="{StaticResource IsValueEqualToParameterConverter}">
                                                        <Binding.ConverterParameter>
                                                            <x:Null/>
                                                        </Binding.ConverterParameter>
                                                    </Binding>
                                                </Condition.Binding>
                                                <Condition.Value>
                                                    <system:Boolean>False</system:Boolean>
                                                </Condition.Value>
                                            </Condition>
                                            <Condition Binding="{Binding ElementName=BuSave, Path=Tag}" >
                                                <!--pass==confirmpass-->
                                                <Condition.Value>
                                                    <system:String>yes</system:String>
                                                </Condition.Value>
                                            </Condition>                                            
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="true" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=CbUpdatePass,Path=IsChecked}" Value="True">
                                        <Setter Property="CommandParameter" Value="{Binding ElementName=PassBoxUserPass}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1"  Margin="2" Command="{Binding DeleteDoctorCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                <TextBlock Text="Delete" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="2"  Margin="2" Command="{Binding CancelChangesToDoctorCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

            </Grid>
            <GridSplitter Background="Gray" Width="1" Margin="1,20,1,20" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <syncfusion:TabControlExt  EnableLabelEdit="False" syncfusion:SkinStorage.VisualStyle="Metro" Margin="5,30,5,5"
                                  CloseButtonType="Hide" ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False" TabStripPlacement="Left">

                    <syncfusion:TabItemExt  MinHeight="35" x:Name="PathologiesTab" >
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Pathologies"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddPathologiesToSelectedDoctorCommand}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Pathologies" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedDoctor.Pathologies}"
                                   SelectedItem="{Binding SelectedPathologyInDoctorsView,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridTextColumn HeaderText="Code" MappingName="CodePathology" />
                                        <syncfusion:GridTextColumn HeaderText="Nom du pathologie" MappingName="NomPathology" />
                                        <syncfusion:GridTextColumn HeaderText="Description" MappingName="Description"/>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="SpecialitiesTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Specialities"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddSpecialitiesToSelectedDoctorCommand}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Spécialités" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                                       AutoGenerateColumns="False"
                                                  ColumnSizer="Star"     
                                       AllowEditing="False"
                                                       SelectionMode="Single"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedDoctor.Specialities}"                                   
                                       ShowGroupDropArea="True" >
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridTextColumn HeaderText="Designation" MappingName="Name" />
                                        <syncfusion:GridTextColumn HeaderText="Code du spécialité" MappingName="Code" />
                                        <syncfusion:GridTextColumn HeaderText="Description" MappingName="Description"/>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="PatientsTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Patients"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddPatientsToSelectedDoctorCommand}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Patients" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="False"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedDoctor.Patients}"
                                   SelectedItem="{Binding SelectedPatientInDoctorView,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridTextColumn HeaderText="NumeroDordre" MappingName="Nom" AllowEditing="False"/>
                                        <syncfusion:GridTextColumn HeaderText="Nom" MappingName="Prenom" AllowEditing="False"/>
                                        <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="TelephoneMobile" AllowEditing="False"/>
                                        <syncfusion:GridTextColumn HeaderText="Sexe" MappingName="Sexe.Designation" AllowEditing="False"/>
                                        <syncfusion:GridTextColumn HeaderText="Mobile" MappingName="TelephoneMobile" AllowEditing="False"/>
                                        <syncfusion:GridTextColumn HeaderText="Pathology" MappingName="Pathology.NomPathology" AllowEditing="False"/>                                        
                                    </syncfusion:SfDataGrid.Columns>

                                </syncfusion:SfDataGrid>

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>



                </syncfusion:TabControlExt>
            </Grid>


        </Grid>
    </Grid>
</Page>
