<Page x:Class="CPMCAppointmentSystem.View.DoctorsViews.DoctorsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="800" DataContext="{Binding Source={StaticResource Locator},Path=DoctorsViewModel}"
	Title="DoctorsView">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=DoctorsViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource NavigationPanelBackgroundBrush}">
            <!--the list of patients Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="20,0,0,0" Text="Medecins" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="0" />
            <Button Grid.Row="0" Grid.Column="1"  Margin="10" Command="{Binding AddDoctorCommand}">
                <Button.Content>
                    <Image Source="{StaticResource AddNewDark}" Width="40" Height="40" ></Image>
                </Button.Content>
            </Button>
            <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
            <syncfusion:SfDataGrid Grid.Column="0" Grid.ColumnSpan="2" AutoGenerateColumns="False" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="sfgrid"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding DoctorsList}"
                                   SelectedItem="{Binding SelectedDoctor,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="Nom" MappingName="User.UserNom" />
                    <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="User.UserPrenom" />
                    <syncfusion:GridTextColumn HeaderText="Spécialité" MappingName="Speciality.Name"/>
                    <syncfusion:GridTextColumn HeaderText="Mobile" MappingName="TelephoneMobile"/>
                    <syncfusion:GridTextColumn HeaderText="Fixe" MappingName="TelephoneFixe"/>
                    <syncfusion:GridTextColumn HeaderText="Date de naiss" DisplayBinding="{Binding Path=DateDeNaissance,
                                                                           StringFormat=d}"/>


                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

        </Grid>
        <GridSplitter Grid.Column="1" Width="1" Background="LightGray" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2" Background="{StaticResource BodyBackgroundBrush}" IsEnabled="{Binding IsFormEnabled}">
            <!--the patients details Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,20" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <Image Source="{StaticResource DoctorDark}" Grid.Column="0" Grid.Row="0" Width="75"/>
                <Border x:Name="WebCamBorder"  Background="WhiteSmoke" Grid.Column="0" Grid.Row="0" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value=".01"></Setter>
                            <Style.Triggers>
                                <Trigger  Property="IsMouseOver"  Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Source="{StaticResource CameraDark}" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0" />
                        <Button Grid.Column="0" Grid.Row="1"  Margin="2" ToolTip="WebCam">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource WebcamDark}" Width="15" Height="15" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Grid.Row="1"  Margin="2" ToolTip="Upload">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource UploadDark}" Width="15" Height="15" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Watermark="Nom" x:Name="NomBox" Margin="10 5" Grid.Column="1" Text="{Binding SelectedDoctor.User.UserNom,Mode=TwoWay}" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>


                <TextBlock Grid.Column="0" Grid.Row="2" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit x:Name="PrenomBox" Margin="10 5" Watermark="Prenom" Grid.Column="1" Text="{Binding SelectedDoctor.User.UserPrenom,Mode=TwoWay}" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Column="0" Grid.Row="3" Text="TelephoneFixe" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Margin="10 5" Watermark="Telephone fixe" x:Name="TelFixBox" Grid.Column="1" Text="{Binding SelectedDoctor.TelephoneFixe,Mode=TwoWay}" Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Column="0" Grid.Row="4" Text="Mobile" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Margin="10 5" Watermark="Telephone mobile" x:Name="Mob1Box" Grid.Column="1" Grid.Row="4" Text="{Binding SelectedDoctor.TelephoneMobile,Mode=TwoWay}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Column="0" Grid.Row="5" Text="Spécialité" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <ComboBox x:Name="SpecialityBox" Margin="10 5" ItemsSource="{Binding SpecialitiesList}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDoctor.Speciality,Mode=TwoWay}" Grid.Column="1" Grid.Row="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Margin="10 5" Grid.Row="5"  Text="Spécialité">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SpecialityBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <GroupBox Header="Données de connection" Margin="0,20,0,0" Grid.Row="7" Grid.Column="0"  Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Nom d'utilisateur" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <syncfusion:SfMaskedEdit Margin="10 5" Watermark="Nom d'utilisateur" x:Name="UserNameBox" Grid.Column="1" Grid.Row="0" Text="{Binding SelectedDoctor.User.UserName,Mode=TwoWay}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Nouveau password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>

                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Confirmé password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <PasswordBox Margin="10 5" Grid.Column="1" Grid.Row="2"  x:Name="UserPass2" Style="{DynamicResource  WaterMarkPasswordBoxStyle}"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <PasswordBox.Resources>
                                <system:String x:Key="WaterMarkText">Confirme password</system:String>
                            </PasswordBox.Resources>
                        </PasswordBox>

                        <PasswordBox Margin="10 5" Grid.Column="1" Grid.Row="1"  x:Name="UserPass" Style="{DynamicResource  WaterMarkPasswordBoxStyle}"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <PasswordBox.Resources>
                                <system:String x:Key="WaterMarkText">Enter password</system:String>
                            </PasswordBox.Resources>
                        </PasswordBox>
                    </Grid>
                </GroupBox>


                <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"  Margin="2" Command="{Binding SaveDoctorCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                <TextBlock Text="Save" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="1"  Margin="2" Command="{Binding DeleteDoctorCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                <TextBlock Text="Delete" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="2"  Margin="2" Command="{Binding CancelChangesToDoctorCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

            </Grid>
            <GridSplitter Background="Gray" Width="1" Margin="1,20,1,20" Grid.Column="1" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <syncfusion:TabControlExt  EnableLabelEdit="False" syncfusion:SkinStorage.VisualStyle="Metro" Margin="5,30,5,5"
                                  CloseButtonType="Hide" ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False" TabStripPlacement="Left">

                    <syncfusion:TabItemExt  MinHeight="35" x:Name="PathologiesTab" >
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Pathologies"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddPathologiesToSelectedDoctorCommand}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Pathologies" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedDoctor.Pathologies}"
                                   SelectedItem="{Binding SelectedPathologyInDoctorsView,Mode=TwoWay}"
                                       ShowGroupDropArea="True" />

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="SpecialitiesTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Specialities"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddSpecialitiesToSelectedDoctorCommand}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Spécialités" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedDoctor.Speciality}"                                   
                                       ShowGroupDropArea="True" />

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="PatientsTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Patients"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddPatientsToSelectedDoctorCommand}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Patients" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedDoctor.Patients}"
                                   SelectedItem="{Binding SelectedPatientInDoctorView,Mode=TwoWay}"
                                       ShowGroupDropArea="True" />

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="StagaireTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Stagaire"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddPatientsToSelectedDoctorCommand}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Stagiaires" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedDoctor.Patients}"
                                   SelectedItem="{Binding SelectedPatientInDoctorView,Mode=TwoWay}"
                                       ShowGroupDropArea="True" />

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>


                </syncfusion:TabControlExt>
            </Grid>


        </Grid>
    </Grid>
</Page>
