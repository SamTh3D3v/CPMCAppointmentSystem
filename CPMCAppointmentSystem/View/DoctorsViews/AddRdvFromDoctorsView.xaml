<controls:MetroWindow x:Class="CPMCAppointmentSystem.View.DoctorsViews.AddRdvFromDoctorsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:command="http://www.galasoft.ch/mvvmlight"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:DataLayer.Enums;assembly=DataLayer"
        xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
        Title="Ajouter un rendez-vousS"
        WindowStyle="SingleBorderWindow"
        EnableDWMDropShadow="True"
        ResizeMode="CanResizeWithGrip"
        WindowTransitionsEnabled="False"                      
        BorderBrush="{DynamicResource AccentColorBr}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"                                 
         Height="500" Width="700" 
                             DataContext="{Binding Path=DoctorsViewModel, Source={StaticResource Locator}}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=AddPatientsToDoctorLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="GridRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Grid.Row="0" Width="75" Height="75" Background="#ffeef0ef">
                <Path Data="{StaticResource DoctorPath}" Fill="#ff7c7c7c" Width="50" Height="50" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  ></Path>
            </Border>
            <controls:ToggleSwitch VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding SelectedAppointement.RdvStateValue,Converter={StaticResource RdvStateValueToBoolConverter},Mode=TwoWay}" Grid.Column="1" HorizontalAlignment="Right" Grid.Row="0"  OnLabel="Activer le rendez-vous" OffLabel="Annuler le rendez-vous">
                <controls:ToggleSwitch.Style>
                    <Style TargetType="controls:ToggleSwitch">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="SelectedAppointement.RendezVousId" Converter="{StaticResource IsValueEqualToParameterConverter}" ConverterParameter="{x:Static system:Guid.Empty}"/>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="SelectedAppointement.RdvStateValue" Converter="{StaticResource IsValueEqualToParameterConverter}" ConverterParameter="{x:Static enums:RdvState.Passed}"/>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:ToggleSwitch.Style>
            </controls:ToggleSwitch>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10" Grid.Row="1">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Column="0" Grid.Row="1" Text="Nom Medecin" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfTextBoxExt Margin="10 5"  x:Name="NomBox" IsEnabled="False" Text="{Binding SelectedDoctor.User.UserNom,Mode=TwoWay}" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>


                <TextBlock Grid.Column="0" Grid.Row="2" Text="Prenom Medecin" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfTextBoxExt Margin="10 5" x:Name="PrenomBox" IsEnabled="False" Text="{Binding SelectedDoctor.User.UserPrenom}" Grid.Column="1" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>


                <TextBlock Grid.Column="0" Grid.Row="4" Text="Date de Rdv" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <DatePicker Name="TxtEditDateRdv" Margin="2 5"  SelectedDate="{Binding SelectedAppointement.DateTimeRdv,Mode=TwoWay,StringFormat='{}{0:dd/MM/yyyy}',UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"   Grid.Column="1" Grid.Row="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <!--<TextBlock Grid.Column="1" Grid.Row="4"  Text="La date du rendez vous" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtEditDateRdv}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>-->

                <TextBlock Grid.Column="0" Grid.Row="5" Text="Lieu de Rdv" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfTextBoxExt Name="TxtEditLieuRdv" Grid.Column="1" Text="{Binding SelectedAppointement.LieuRdv,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"  Margin="2 5" HorizontalContentAlignment="Left" Grid.Row="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                                     
                                     Watermark="Lieu du rendez vous"  
                                     />

                <TextBlock Grid.Column="0" Grid.Row="6" Text="Patient" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <Syncfusion:SfTextBoxExt IsEnabled="False" Name="TxtEditMedecin" Grid.Column="1" Text="{Binding SelectedAppointement.Patient.Nom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}"  Margin="2 5" HorizontalContentAlignment="Left" Grid.Row="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"                                     
                                     Watermark="selectionnez un patient"  
                                     />

                <Expander Name="ExpMed"  Header="Sélectionner un patient" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />                            
                        </Grid.RowDefinitions>                        
                        <Syncfusion:SfDataGrid Grid.Row="0"  Height="250" SelectionMode="Single"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="WhiteSmoke"
                                       AllowDraggingColumns="True"
                                               ColumnSizer="Star"
                                       AllowEditing="False"                                               
                                       AllowFiltering="True"
                                       AllowGrouping="True" 
                                               ItemsSource="{Binding ElementName=DoctorDataPager,Path=PagedSource}"                                       
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedAppointement.Patient,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                            <Syncfusion:SfDataGrid.Columns>
                                <Syncfusion:GridTextColumn HeaderText="NumeroDordre" MappingName="Nom" AllowEditing="False"/>
                                <Syncfusion:GridTextColumn HeaderText="Nom" MappingName="Prenom" AllowEditing="False"/>
                                <Syncfusion:GridTextColumn HeaderText="Prenom" MappingName="TelephoneMobile" AllowEditing="False"/>
                                <Syncfusion:GridTextColumn HeaderText="Sexe" MappingName="Sexe.Designation" AllowEditing="False"/>
                                <Syncfusion:GridTextColumn HeaderText="Mobile" MappingName="TelephoneMobile" AllowEditing="False"/>
                                <Syncfusion:GridTextColumn HeaderText="Pathology" MappingName="Pathology.NomPathology" AllowEditing="False"/>
                            </Syncfusion:SfDataGrid.Columns>
                        </Syncfusion:SfDataGrid>
                        <Syncfusion:SfDataPager x:Name="DoctorDataPager"
                                       Grid.Row="1"                                       
                                       
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       AccentBackground="#FF53C3D5"
                                       AccentForeground="White"
                                       NumericButtonCount="10"
                                       Orientation="Horizontal"
                                       PageSize="16"
                                       Source="{Binding PatientsList,Mode=TwoWay}" />
                    </Grid>
                </Expander>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2" Grid.Column="0"  Margin="5" VerticalAlignment="Bottom" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"  Margin="2" Command="{Binding SaveAppointementCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                        <TextBlock Text="Save" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="IsEnabled" Value="false" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=TxtEditDateRdv, Path=(Validation.HasError)}" Value="false" />
                                    <Condition Binding="{Binding ElementName=TxtEditLieuRdv, Path=(Validation.HasError)}" Value="false" />
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="SelectedAppointement.Medecin" Converter="{StaticResource IsValueEqualToParameterConverter}">
                                                <Binding.ConverterParameter>
                                                    <x:Null/>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                    <Condition>
                                        <Condition.Binding>
                                            <Binding Path="SelectedAppointement.Patient" Converter="{StaticResource IsValueEqualToParameterConverter}">
                                                <Binding.ConverterParameter>
                                                    <x:Null/>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </Condition.Binding>
                                        <Condition.Value>
                                            <system:Boolean>False</system:Boolean>
                                        </Condition.Value>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="true" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="1"  Margin="2" Command="{Binding DeleteAppointementCommand}" >
                <Button.Style>
                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"></Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedAppointement}" Value="{x:Static system:Guid.Empty}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                        <TextBlock Text="Delete" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>

            </Button>
            <Button Grid.Column="2"  Margin="2" Command="{Binding CancelAppointementChangesCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                        <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>

</controls:MetroWindow>
