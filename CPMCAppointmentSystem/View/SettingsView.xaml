<Page x:Class="CPMCAppointmentSystem.View.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="700" DataContext="{Binding Source={StaticResource Locator},Path=SettingsViewModel}"
	Title="SettingsView" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=SettingsViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Page.Resources>
        <Style TargetType="syncfusion:TreeViewItemAdv" x:Key="TreeViewItemConStyle">
            <Setter Property="IsExpanded" Value="True"/>
            <!--<Setter Property="LeftImageSource" Value="{StaticResource PathologyDark}"/>-->
        </Style>
        <HierarchicalDataTemplate x:Key="TvItemTemplate" ItemsSource="{Binding TreeViewModelCollection}">
            <CheckBox Content="{Binding Content}" IsChecked="{Binding Path=IsChecked,Mode=TwoWay}"/>
        </HierarchicalDataTemplate>
    </Page.Resources>

    <Grid  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TabControl  TabStripPlacement="Left"  Padding="0" Margin="0">
            <TabItem Style="{StaticResource SettingsTabItemStyle}">
                <TabItem.Header>
                    <Grid Width="120" Height="100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Source="{StaticResource AccountsDark}"></Image>
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}"  Foreground="#FF7B7B7B" Text="ACCOUNTS" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListView ItemsSource="{Binding UserTypeCollection}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2" Background="WhiteSmoke">
                                        <controls:ToggleSwitch  Header="{Binding UserTypeName}" OnLabel="On" OffLabel="Off" IsChecked="{Binding IsAdded}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>
                        <Grid Grid.Column="0" Grid.Row="1" Margin="4">
                            <syncfusion:SfDataGrid ColumnSizer="Star" AddNewRowPosition="Bottom"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True" 
                                                   AllowDeleting="True"
                                       ItemsSource="{Binding UsersList,Mode=TwoWay}"
                                   AutoGenerateColumns="False"
                                   SelectedItem="{Binding SelectedUser,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn HeaderText="Nom" MappingName="UserNom" />
                                    <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="UserPrenom"/>
                                    <syncfusion:GridTextColumn HeaderText="UserName" MappingName="UserName"/>
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </Grid>
                        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Background="Gray" Width="1" Margin="1" Grid.Column="1" VerticalAlignment="Stretch"/>
                        <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Grid.Column="0"  Header="Basic inoformation">
                                
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <syncfusion:SfMaskedEdit  Grid.Column="1" Text="{Binding SelectedUser.UserNom,Mode=TwoWay}" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Nom de l'utilisateur"  
                                     />

                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <syncfusion:SfMaskedEdit Grid.Column="1" Text="{Binding SelectedUser.UserPrenom,Mode=TwoWay}" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Prenom de l'utilisateur" 
                                     />

                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="UserName" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <syncfusion:SfMaskedEdit Grid.Column="1" Text="{Binding SelectedUser.UserName,Mode=TwoWay}" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10 5"                                      
                                     Watermark="Prenom de l'utilisateur" 
                                     />
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Row="1" Grid.Column="0">
                                <GroupBox.Header>
                                    <CheckBox Content="Change password" x:Name="PassCheckBox" IsChecked="False"></CheckBox>
                                </GroupBox.Header>
                                <Grid IsEnabled="{Binding ElementName=PassCheckBox,Path=IsChecked}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <PasswordBox Margin="10 5"  x:Name="UserPass" Style="{DynamicResource  WaterMarkPasswordBoxStyle}" Grid.Column="1" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <PasswordBox.Resources>
                                            <system:String x:Key="WaterMarkText">Enter password</system:String>
                                        </PasswordBox.Resources>
                                    </PasswordBox>

                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Confirm Password" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                                    <PasswordBox Margin="10 5" x:Name="UserConfirmPass" Style="{StaticResource WaterMarkPasswordBoxStyle}" Grid.Column="1" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <PasswordBox.Resources>
                                            <system:String x:Key="WaterMarkText">Confirme password</system:String>
                                        </PasswordBox.Resources>
                                    </PasswordBox>
                                </Grid>
                            </GroupBox>

                            <Expander IsExpanded="True" Grid.Row="2" Grid.Column="0"  Header="Rolls">
                                <syncfusion:TreeViewAdv ItemsSource="{Binding TreeViewRollCollection}" ItemTemplate="{StaticResource TvItemTemplate}" Background="Transparent" BorderThickness="0"  HorizontalAlignment="Stretch"
                                            AnimationType="Fade"
                                            ItemContainerStyle="{StaticResource TreeViewItemConStyle}" 
                                            ShowRootLines="True" 
                                            AllowMultiSelect="False" 
                                            AllowDragDrop="False">
                                </syncfusion:TreeViewAdv>
                            </Expander>
                            <Grid Grid.Row="4" Grid.Column="0"  VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"  Margin="2" Command="{Binding SaveSpecialityCommand}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                            <TextBlock Text="Save" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <Button Grid.Column="1"  Margin="2" Command="{Binding DeleteSpecialityCommand}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                            <TextBlock Text="Delete" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <Button Grid.Column="2"  Margin="2" Command="{Binding CancelSpecialityChangesCommand}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                            <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem Style="{StaticResource SettingsTabItemStyle}">
                <TabItem.Header>
                    <Grid Width="120" Height="100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Source="{StaticResource SettingsDark}"></Image>
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}"  Foreground="#FF7B7B7B" Text="SETTINGS" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <TabItem.Content>
                    <TabControl >
                        <TabItem Header="Patients Status">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <GroupBox Header="Carte proffesionel" Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Tiles brush" VerticalAlignment="Center"/>
                                        <xctk:ColorPicker Grid.Row="0" Grid.Column="1" Margin="30,5,5,5"  
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"                                                                                                                                                                                  
                                            />
                                        <controls:ToggleSwitch Grid.Row="0" Grid.Column="2" Width="150"  OnLabel="Blink" OffLabel="don't blink" />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Enfant" Grid.Row="0" Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Tiles brush" VerticalAlignment="Center"/>
                                        <xctk:ColorPicker Grid.Row="0" Grid.Column="1" Margin="30,5,5,5"  
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"                                                                                                                                                                                  
                                            />
                                        <controls:ToggleSwitch Grid.Row="0" Grid.Column="2" Width="150"  OnLabel="Blink" OffLabel="don't blink" Grid.ColumnSpan="2" Margin="0,2,38,31" Grid.RowSpan="2" />
                                        <TextBlock Text="Age minimum" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
                                        <syncfusion:SfMaskedEdit Margin="30,5,5,5"  Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"></syncfusion:SfMaskedEdit>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Pieces joints Type" >
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <command:EventToCommand 
                            PassEventArgsToCommand="True" Command="{Binding TypePieceJointeDataGridLoadedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <GroupBox Header="Ajouter Une Type De Piece Jointe" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <syncfusion:SfDataGrid   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AddNewRowPosition="Top" AllowDeleting="True" 
                                                       AutoGenerateColumns="False"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding TypePieceJointeCollection}"
                                   SelectedItem="{Binding SelectedTypePieceJointe,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <command:EventToCommand 
                            PassEventArgsToCommand="True" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <syncfusion:SfDataGrid.Columns>
                                            <syncfusion:GridTextColumn HeaderText="Titre" Width="300" MappingName="PieceJointeTitle" />
                                            <syncfusion:GridTextColumn HeaderText="Description" Width="300" MappingName="Description"/>
                                        </syncfusion:SfDataGrid.Columns>
                                    </syncfusion:SfDataGrid>
                                </GroupBox>
                                <Grid Grid.Row="1" Grid.Column="0"  VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" HorizontalAlignment="Right" Width="200"  Margin="2" Command="{Binding SaveAddTypePieceJointsCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                                <TextBlock Text="Save" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Left" Width="200"  Margin="2" Command="{Binding CancelAddTypePieceJointsCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                                <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Other">
                            <TextBlock Text="In Progress" Style="{DynamicResource HeaderTextBlockStyle}" Foreground="Black"/>
                        </TabItem>
                    </TabControl>
                </TabItem.Content>
            </TabItem>
            <TabItem Style="{StaticResource SettingsTabItemStyle}">
                <TabItem.Header>
                    <Grid Width="120" Height="100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Source="{StaticResource AccountsDark}"></Image>
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}"  Foreground="#FF7B7B7B" Text="NOTIFICATIONS" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <TabItem.Content>
                    <TabControl >
                        <TabItem Header="Sms Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <GroupBox Header="Global Settings" Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Centre du messegerie" VerticalAlignment="Center" Grid.Row="0"/>
                                        <syncfusion:SfMaskedEdit Margin="30,5,5,5" Text="+213550001701" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch"></syncfusion:SfMaskedEdit>
                                        <TextBlock Text="Between AT cmd delay" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                                        <syncfusion:SfMaskedEdit Margin="30,5,5,5" Text="1000" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch"></syncfusion:SfMaskedEdit>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Core sms" Grid.Row="1" Grid.Column="0">
                                    <StackPanel>
                                        <Grid Margin="5" Background="WhiteSmoke">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Message de notification [Françcais]" TextWrapping="Wrap" Width="150" VerticalAlignment="Center" Grid.Row="0"/>
                                            <syncfusion:SfMaskedEdit Margin="5" Text="Confirmation du rendez vous" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch"></syncfusion:SfMaskedEdit>
                                        </Grid>
                                        <Grid Margin="5" Background="WhiteSmoke">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Message de notification [Arab]" TextWrapping="Wrap" Width="150" VerticalAlignment="Center" Grid.Row="0"/>
                                            <syncfusion:SfMaskedEdit Margin="5" Text="تأكيد الموعد" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch"></syncfusion:SfMaskedEdit>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                                <Grid Grid.Row="2" Grid.Column="0"  VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"  Margin="2" Command="{Binding SaveAppointementCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                                <TextBlock Text="Save" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Grid.Column="1"  Margin="2" Command="{Binding CancelAppointementChangesCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                                <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                            </Grid>
                        </TabItem>
                        <TabItem Header="Appel Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <GroupBox Header="Appelle Vocale Automatique" Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Appelle vocale" Width="100" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Row="0"/>
                                        <ProgressBar Grid.Row="0" Foreground="LightSkyBlue" Value="80" Grid.Column="1" HorizontalAlignment="Stretch" Height="5"/>
                                        <Button Style="{DynamicResource MetroCircleButtonStyle}" Grid.Row="0" Grid.Column="2" Width="100" Height="100">
                                            <Path Data="F1M-224.553,1265L-246.174,1283.52 -267.792,1302.04 -267.792,1265 -267.792,1227.97 -246.174,1246.49 -224.553,1265z" Stretch="Uniform" Fill="#FF000000" Width="50" Height="50" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <TransformGroup>
                                                        <TransformGroup.Children>
                                                            <RotateTransform Angle="0" />
                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                        </TransformGroup.Children>
                                                    </TransformGroup>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                        <Button ToolTip="Supprimer l'appelle Vocale" Style="{DynamicResource MetroCircleButtonStyle}" Grid.Row="0" Grid.Column="3" Width="40" Height="40">
                                            <Path Data="M33.977998,27.684L33.977998,58.102997 41.373998,58.102997 41.373998,27.684z M14.841999,27.684L14.841999,58.102997 22.237998,58.102997 22.237998,27.684z M4.0319996,22.433001L52.183,22.433001 52.183,63.999001 4.0319996,63.999001z M15.974,0L40.195001,0 40.195001,7.7260003 56.167001,7.7260003 56.167001,16.000999 0,16.000999 0,7.7260003 15.974,7.7260003z" Stretch="Uniform" Fill="#FF000000" Width="15" Height="15" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <TransformGroup>
                                                        <TransformGroup.Children>
                                                            <RotateTransform Angle="0" />
                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                        </TransformGroup.Children>
                                                    </TransformGroup>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                        <TextBlock Text="Enregistrer une nouvelle appelle vocale " Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" HorizontalAlignment="Center"></TextBlock>
                                        <Button ToolTip="Supprimer l'appelle Vocale" Style="{DynamicResource MetroCircleButtonStyle}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Width="150" Height="150" Margin="50">

                                            <Path Data="M1725.25,2303.97C1729.64,2303.97,1733.2,2300.41,1733.2,2296.02L1733.2,2278.49C1733.2,2274.1 1729.64,2270.54 1725.25,2270.54 1720.86,2270.54 1717.3,2274.1 1717.3,2278.49L1717.3,2296.02C1717.3,2300.41,1720.86,2303.97,1725.25,2303.97z M1742.45,2297.75L1738.72,2297.75C1738.22,2304.75 1732.38,2310.28 1725.25,2310.28 1718.12,2310.28 1712.28,2304.75 1711.78,2297.75L1708.05,2297.75C1708.05,2306.51,1714.61,2313.72,1723.07,2314.79L1723.07,2319.58 1717.2,2319.58 1717.2,2323.87 1733.26,2323.87 1733.26,2319.58 1727.43,2319.58 1727.43,2314.79C1735.9,2313.72,1742.45,2306.51,1742.45,2297.75z" Stretch="Uniform" Fill="#FF000000" Width="90" Height="90" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <TransformGroup>
                                                        <TransformGroup.Children>
                                                            <RotateTransform Angle="0" />
                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                        </TransformGroup.Children>
                                                    </TransformGroup>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                    </Grid>
                                </GroupBox>
                                <Grid Grid.Row="2" Grid.Column="0"  VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" HorizontalAlignment="Right" Width="200"  Margin="2" Command="{Binding SaveAppointementCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                                <TextBlock Text="Save" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Left" Width="200"  Margin="2" Command="{Binding CancelAppointementChangesCommand}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                                <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem.Content>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
