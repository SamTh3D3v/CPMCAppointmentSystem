<Page x:Class="CPMCAppointmentSystem.View.DoctorsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="800" DataContext="{Binding Source={StaticResource Locator},Path=DoctorsViewModel}"
	Title="DoctorsView">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource NavigationPanelBackgroundBrush}">
            <!--the list of patients Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="20,0,0,0" Text="Doctors" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="0" />
            <Button Grid.Row="0" Grid.Column="1"  Margin="10" >
                <Button.Content>
                    <Image Source="{StaticResource AddNewDark}" Width="40" Height="40" ></Image>
                </Button.Content>
            </Button>
            <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
            <syncfusion:SfDataGrid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="sfgrid"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding DoctorsList}"
                                   SelectedItem="{Binding SelectedDoctor,Mode=TwoWay}"
                                       ShowGroupDropArea="True" />

        </Grid>
        <GridSplitter Grid.Column="1" Width="1" Background="LightGray" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2" Background="{StaticResource BodyBackgroundBrush}">
            <!--the patients details Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                   
                </Grid.RowDefinitions>
                <Image Source="{StaticResource DoctorDark}" Grid.Column="0" Grid.Row="0" Width="75"/>
                <!--To be updated with the proper control-->
                <TextBlock Grid.Column="1" Grid.Row="0" Text="GeneratedID" VerticalAlignment="Center" Margin="5"/>

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <TextBox x:Name="NomBox" Grid.Column="1" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="1"  Text="Nom" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NomBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>


                <TextBlock Grid.Column="0" Grid.Row="2" Text="Prenom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <TextBox x:Name="PrenomBox" Grid.Column="1" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="2"  Text="Prenom" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=PrenomBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="0" Grid.Row="3" Text="TelephoneFixe" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <TextBox x:Name="TelFixBox" Grid.Column="1" Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="3"  Text="TelephoneFixe">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TelFixBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="0" Grid.Row="4" Text="Mobile 1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <TextBox x:Name="Mob1Box" Grid.Column="1" Grid.Row="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Grid.Row="4"  Text="Mobile 1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Mob1Box}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>               

            </Grid>
            <GridSplitter Background="Gray" Width="1" Margin="1,20,1,20" Grid.Column="1" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <syncfusion:TabControlExt  EnableLabelEdit="False" syncfusion:SkinStorage.VisualStyle="Metro" Margin="5,30,5,5"
                                  CloseButtonType="Hide" ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False" TabStripPlacement="Left">

                    <syncfusion:TabItemExt  MinHeight="35" x:Name="PathologiesTab" >
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Pathologies"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" >
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Pathologies" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding PatientList}"
                                   SelectedItem="{Binding SelectedPatient,Mode=TwoWay}"
                                       ShowGroupDropArea="True" />

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="SpecialitiesTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Specialities"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" >
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Specialities" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding PatientList}"
                                   SelectedItem="{Binding SelectedPatient,Mode=TwoWay}"
                                       ShowGroupDropArea="True" />

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="PatientsTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Patients"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" >
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Patients" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding PatientList}"
                                   SelectedItem="{Binding SelectedPatient,Mode=TwoWay}"
                                       ShowGroupDropArea="True" />

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>
                    <syncfusion:TabItemExt  MinHeight="35" x:Name="NotesTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Notes"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                    </syncfusion:TabItemExt>


                    <!--<Syncfusion:TabControlExt.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ItemTemplate>
                    <Syncfusion:TabControlExt.ContentTemplate>
                        <DataTemplate>
                            <local:Weather BorderBrush="{Binding ElementName=options, Path=BorderBrush}" x:Name="weather"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ContentTemplate>-->
                </syncfusion:TabControlExt>
            </Grid>


        </Grid>
    </Grid>
</Page>
