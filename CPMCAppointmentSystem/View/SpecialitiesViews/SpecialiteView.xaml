<Page x:Class="CPMCAppointmentSystem.View.SpecialitiesViews.SpecialiteView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:command="http://www.galasoft.ch/mvvmlight"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800" DataContext="{Binding Source={StaticResource Locator},Path=SpecialityViewModel}"
	Title="SpecialiteView">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=SpecialitiesViewLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource NavigationPanelBackgroundBrush}">
            <!--the list of patients Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="20,0,0,0" Text="Specialities" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="0" />
            <Button Grid.Row="0" Grid.Column="1"  Margin="10" Command="{Binding AddSpecialityCommand}">
                <Button.Content>
                    <Image Source="{StaticResource AddNewDark}" Width="40" Height="40" ></Image>
                </Button.Content>
            </Button>
            <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>
            <syncfusion:SfDataGrid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="sfgrid"
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SpecialityList}"
                                   SelectedItem="{Binding SelectedSpeciality,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="Designation" MappingName="Name" />
                    <syncfusion:GridTextColumn HeaderText="Code du spécialité" MappingName="Code" />
                    <syncfusion:GridTextColumn HeaderText="Description" MappingName="Description"/>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

        </Grid>
        <GridSplitter Grid.Column="1" Width="1" Background="LightGray" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2" Background="{StaticResource BodyBackgroundBrush}" IsEnabled="{Binding IsFormEnabled}">
            <!--the patients details Grid-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <Image Source="{StaticResource SpecialityDark}" Grid.Column="0" Grid.Row="0" Width="75"/>              

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Nom" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit  Watermark="Nom du specilaité" x:Name="TxtEditNomSpec" 
                                           Grid.Column="1" Text="{Binding SelectedSpeciality.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>                

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Code" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Watermark="Code du specialité"  x:Name="TxtEditCodeSpec" 
                                         Text="{Binding SelectedSpeciality.Code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true, NotifyOnValidationError=False}" 
                                         Grid.Column="1" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>                

                <TextBlock Grid.Column="0" Grid.Row="3" Text="Description" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                <syncfusion:SfMaskedEdit Watermark="Description du spécialité" x:Name="DescriptionBox" Text="{Binding SelectedSpeciality.Description,Mode=TwoWay}" Grid.Column="1" Grid.Row="3"  Grid.RowSpan="2"  Height="Auto" />

                <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"  Margin="2" Command="{Binding SaveSpecialityCommand}" >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                                <TextBlock Text="Save" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="false" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ElementName=TxtEditNomSpec, Path=(Validation.HasError)}" Value="false" />
                                            <Condition Binding="{Binding ElementName=TxtEditCodeSpec, Path=(Validation.HasError)}" Value="false" />
                                            <Condition>
                                                <Condition.Binding>
                                                    <Binding Path="SelectedSpeciality" Converter="{StaticResource IsValueEqualToParameterConverter}">
                                                        <Binding.ConverterParameter>
                                                            <x:Null/>
                                                        </Binding.ConverterParameter>
                                                    </Binding>
                                                </Condition.Binding>
                                                <Condition.Value>
                                                    <system:Boolean>False</system:Boolean>
                                                </Condition.Value>
                                            </Condition>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="true" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1"  Margin="2" Command="{Binding DeleteSpecialityCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource DeleteDark}" Width="20" Height="20" />
                                <TextBlock Text="Delete" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSpeciality.SpecialiteId}">
                                        <DataTrigger.Value>
                                            <system:Guid>00000000-0000-0000-0000-000000000000</system:Guid>
                                        </DataTrigger.Value>
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2"  Margin="2" Command="{Binding CancelSpecialityChangesCommand}" >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                                <TextBlock Text="Cancel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

            </Grid>
            <GridSplitter Background="Gray" Width="1" Margin="1,20,1,20" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <syncfusion:TabControlExt  EnableLabelEdit="False" syncfusion:SkinStorage.VisualStyle="Metro" Margin="5,30,5,5"
                                  CloseButtonType="Hide" ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False" TabStripPlacement="Left">

                    <syncfusion:TabItemExt  MinHeight="35" x:Name="DoctorsTab">
                        <syncfusion:TabItemExt.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                                    <TextBlock Grid.Row="0" Text="Medecins"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:TabItemExt.HeaderTemplate>
                        <syncfusion:TabItemExt.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"  Margin="10" Command="{Binding AddDoctorToSpeciality}">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewDark}" Width="25" Height="25" ></Image>
                                    </Button.Content>
                                </Button>
                                <TextBlock Margin="20,0,0,0" Text="Medecins" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Grid.Column="1" />
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="1" Fill="LightGray" Margin="10,0,10,0"/>

                                <syncfusion:SfDataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                       AllowDraggingColumns="True"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"
                                       ItemsSource="{Binding SelectedSpeciality.Medecins}"
                                   SelectedItem="{Binding SelectedDoctor,Mode=TwoWay}"
                                       ShowGroupDropArea="True" >
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridTextColumn HeaderText="Nom" MappingName="User.UserNom" />
                                        <syncfusion:GridTextColumn HeaderText="Prenom" MappingName="User.UserPrenom" />
                                        <syncfusion:GridTextColumn HeaderText="Mobile" MappingName="TelephoneMobile"/>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>

                            </Grid>
                        </syncfusion:TabItemExt.Content>
                    </syncfusion:TabItemExt>                    


                    <!--<Syncfusion:TabControlExt.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ItemTemplate>
                    <Syncfusion:TabControlExt.ContentTemplate>
                        <DataTemplate>
                            <local:Weather BorderBrush="{Binding ElementName=options, Path=BorderBrush}" x:Name="weather"/>
                        </DataTemplate>
                    </Syncfusion:TabControlExt.ContentTemplate>-->
                </syncfusion:TabControlExt>
            </Grid>


        </Grid>
    </Grid>
</Page>
