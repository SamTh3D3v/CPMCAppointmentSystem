<controls:MetroWindow x:Class="CPMCAppointmentSystem.View.PathologiesViews.AddDoctorsToPathologyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:command="http://www.galasoft.ch/mvvmlight"
        xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
         WindowStyle="SingleBorderWindow"
                      Title="Affecte des medecins a une pathologie"
                      EnableDWMDropShadow="True"
                      ResizeMode="CanResizeWithGrip"
                      WindowTransitionsEnabled="False"                      
 BorderBrush="{DynamicResource AccentColorBr}"
                      BorderThickness="1"
        WindowStartupLocation="CenterScreen"                      
                             
         Height="500" Width="700" 
                             DataContext="{Binding Path=PathologiesViewModel, Source={StaticResource Locator}}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <command:EventToCommand Command="{Binding Mode=OneWay, Path=AddDoctorToPathologyLoadedCommand}"
                            PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid  Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Source="{StaticResource DoctorDark}" Grid.Column="0" Grid.Row="0" Width="75"/>


        <TextBlock Grid.Column="0" Grid.Row="1" Text="Pathologie" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
        <Syncfusion:SfTextBoxExt Watermark="Nom du Pathology" Margin="10 5" x:Name="NomBox" IsEnabled="False" Text="{Binding SelectedPathology.NomPathology,Mode=TwoWay}" Grid.Column="1" HorizontalContentAlignment="Left" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>


        <TextBlock Grid.Column="0" Grid.Row="2" Text="Code" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
        <Syncfusion:SfTextBoxExt Margin="10 5" Watermark="Code" x:Name="CodeBox" IsEnabled="False" Text="{Binding SelectedPathology.CodePathology}" Grid.Column="1" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>


        <Expander IsExpanded="True" x:Name="PExpander" Margin="5" Grid.Column="0" Grid.ColumnSpan="2" Syncfusion:SkinStorage.VisualStyle="Metro"
                  Grid.Row="3" Header="Selectionnez les medecins a ajouté"  HorizontalAlignment="Stretch">
            <Grid Margin="5"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >
                <Syncfusion:SfDataGrid SelectionMode="Multiple" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="WhiteSmoke"
                                       AllowDraggingColumns="True"
                                       ColumnSizer="Star"
                                       AllowEditing="True"
                                       AllowFiltering="True"
                                       AllowGrouping="True"                                   
                                       ItemsSource="{Binding DoctorsToPathlogyList}"
                                   AutoGenerateColumns="False"                                   
                                       ShowGroupDropArea="True" >

                    <Syncfusion:SfDataGrid.Columns>
                        <Syncfusion:GridTextColumn HeaderText="Nom" MappingName="Entity.User.UserNom" AllowEditing="False"/>
                        <Syncfusion:GridTextColumn HeaderText="Prenom" MappingName="Entity.User.UserPrenom" AllowEditing="False"/>
                        <Syncfusion:GridTextColumn HeaderText="Mobile" MappingName="Entity.TelephoneMobile" AllowEditing="False"/>
                        <Syncfusion:GridCheckBoxColumn HeaderText="Ajouter" MappingName="IsAdded" AllowEditing="True"/>
                    </Syncfusion:SfDataGrid.Columns>
                </Syncfusion:SfDataGrid>
            </Grid>
        </Expander>

        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>                
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"  Margin="2" Command="{Binding SavePathologyWhithDoctorsCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource SaveDark}" Width="20" Height="20" />
                        <TextBlock Text="Save" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>           
            <Button Grid.Column="2"  Margin="2" Command="{Binding CancelPathologyWhithDoctorsCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource CancelDark}" Width="20" Height="20" />
                        <TextBlock Text="Cancel" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</controls:MetroWindow>
